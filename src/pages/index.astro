---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCards, type PostCard } from '../lib/articles';
import { selectHomepage } from '../lib/homepage';
import '../styles/home.css';

const home = selectHomepage(await getCards());
const date = (card: PostCard) => card.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const desks = [
 { name: 'The style edit', category: 'style', intro: 'The clothes, craft and ideas behind what we wear.', stories: home.style },
 { name: 'Beauty, considered', category: 'beauty', intro: 'Asian beauty, from formulation to the culture around it.', stories: home.beauty },
 { name: 'At home', category: 'living', intro: 'Spaces, materials and the pleasures of everyday living.', stories: home.living },
].filter(desk => desk.stories.length);
const places = [
 { name: 'At the table', category: 'dining', stories: home.dining },
 { name: 'A sense of place', category: 'travel', stories: home.travel },
].filter(desk => desk.stories.length);
---
<BaseLayout title="Arahkaii — Modern Asian luxury, culture and influential lives" description="Arahkaii is Asia's considered edit of style, beauty, design, travel, dining, culture and the people shaping modern luxury." hideFooterNewsletter>
 <div class="home-shell">
  <header class="home-intro">
   <p class="home-kicker">Asia’s modern-luxury edit — modestly told</p>
   <h1>A considered view of modern Asia.</h1>
   <p>People, places and ideas worth your attention.</p>
  </header>

  {home.cover && <section class="home-cover" aria-labelledby="cover-title">
   <a class="home-cover__image media" href={home.cover.url} tabindex="-1" aria-hidden="true"><Image src={home.cover.image} alt="" loading="eager" fetchpriority="high" widths={[480, 800, 1200, 1600]} sizes="(max-width:800px) calc(100vw - 40px), (max-width:1384px) 57vw, 750px" /></a>
   <div class="home-cover__copy">
    <p class="home-kicker">The cover story <span aria-hidden="true">/</span> {home.cover.categoryLabel}</p>
    <h2 id="cover-title"><a href={home.cover.url}>{home.cover.title}</a></h2>
    <p class="home-cover__dek">{home.cover.standfirst}</p>
    <p class="home-byline">{home.cover.byline} <span aria-hidden="true">·</span> {home.cover.readingMinutes} min read</p>
    <a class="home-link" href={home.cover.url}>Read the story <span aria-hidden="true">↗</span></a>
   </div>
  </section>}

  <section class="home-section home-latest" id="latest-stories" aria-labelledby="latest-title">
   <div class="home-section-head"><div><p class="home-kicker">From the journal</p><h2 id="latest-title">Latest stories</h2></div><a class="home-link" href="/latest/">View all stories <span aria-hidden="true">→</span></a></div>
   <div class="home-latest__grid">{home.latest.map(card => <article class="home-story" data-published={card.date.toISOString()}>
    <a class="media home-story__image" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" loading="lazy" widths={[320, 640, 960]} sizes="(max-width:600px) calc(100vw - 40px), (max-width:1000px) 45vw, 30vw" /></a>
    <p class="home-kicker">{card.categoryLabel} <span aria-hidden="true">/</span> <time datetime={card.date.toISOString()}>{date(card)}</time></p>
    <h3><a href={card.url}>{card.title}</a></h3>
    <p class="home-byline">{card.byline} <span aria-hidden="true">·</span> {card.readingMinutes} min read</p>
   </article>)}</div>
  </section>

  <aside class="home-editorial-note" aria-label="Our editorial approach"><p class="home-kicker">Arahkaii, considered</p><p>A point of view. A source you can follow.</p><a class="home-link" href="/editorial-standards/">Our editorial standards <span aria-hidden="true">↗</span></a></aside>

  <div class="home-desks">{desks.map(desk => <section class="home-desk" data-home-category={desk.category} aria-labelledby={`desk-${desk.category}`}>
   <div class="home-section-head"><h2 id={`desk-${desk.category}`}>{desk.name}</h2></div><p class="home-desk__intro">{desk.intro}</p>
   {desk.stories.map((card, i) => <article class:list={['home-desk-story', { 'home-desk-story--lead': i === 0 }]}>
    {i === 0 && <a class="media" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" loading="lazy" widths={[320,640,960]} sizes="(max-width:800px) calc(100vw - 40px), 30vw" /></a>}
    <h3><a href={card.url}>{card.title}</a></h3>{i === 0 && <p class="home-byline">{card.byline}</p>}
   </article>)}<a class="home-link" href={`/${desk.category}/`}>Explore {desk.category} <span aria-hidden="true">→</span></a>
  </section>)}</div>

  {places.length > 0 && <div class="home-places">{places.map(desk => <section class="home-place" data-home-category={desk.category} aria-labelledby={`desk-${desk.category}`}>
   <div class="home-section-head"><h2 id={`desk-${desk.category}`}>{desk.name}</h2><a class="home-link" href={`/${desk.category}/`}>Explore {desk.category} <span aria-hidden="true">→</span></a></div>
   {desk.stories.map(card => <article class="home-place-story"><a class="media" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" loading="lazy" widths={[320,640,960]} sizes="(max-width:800px) calc(100vw - 40px), 44vw" /></a><div><h3><a href={card.url}>{card.title}</a></h3><p>{card.standfirst}</p><p class="home-byline">{card.byline}</p></div></article>)}
  </section>)}</div>}

  {home.culture.length > 0 && <section class="home-section home-culture" aria-labelledby="culture-title">
   <div class="home-section-head"><div><p class="home-kicker">People & culture</p><h2 id="culture-title">A wider lens</h2></div><a class="home-link" href="/culture/">Explore culture <span aria-hidden="true">→</span></a></div>
   <div class="home-culture__grid">{home.culture.map(card => <article class="home-story"><a class="media home-story__image" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" loading="lazy" widths={[320,640,960]} sizes="(max-width:600px) calc(100vw - 40px), 30vw" /></a><p class="home-kicker">{card.categoryLabel}</p><h3><a href={card.url}>{card.title}</a></h3><p class="home-byline">{card.byline}</p></article>)}</div>
  </section>}

  <section class="home-newsletter" aria-labelledby="newsletter-title"><div><p class="home-kicker">The Arahkaii newsletter</p><h2 id="newsletter-title">A little perspective<br />in your inbox.</h2><p>Our latest stories, thoughtful edits and ideas to return to.</p></div><NewsletterSignup class="home-newsletter__form" source="homepage"><p slot="note" class="field-note">By subscribing, you agree to receive emails from Arahkaii. Unsubscribe at any time.</p></NewsletterSignup></section>
 </div>
</BaseLayout>
