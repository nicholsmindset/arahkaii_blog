---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCards, type PostCard } from '../lib/articles';
import '../styles/home.css';

const cards = await getCards();
const byCategory = (category: string) => cards.filter((card) => card.category === category);
const unique = (items: PostCard[]) => [...new Map(items.map((item) => [item.id, item])).values()];
const fill = (preferred: PostCard[], count: number, exclude: PostCard[] = []) => {
	const excluded = new Set(exclude.map((item) => item.id));
	return unique([...preferred, ...cards]).filter((item) => !excluded.has(item.id)).slice(0, count);
};
const date = (card: PostCard) => card.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const hero = fill([...byCategory('style').slice(0, 1), ...byCategory('living').slice(0, 1), ...byCategory('people').slice(0, 1)], 3);
const heroLead = hero[1] ?? hero[0];
const friday = fill(cards.filter((card) => !hero.some((item) => item.id === card.id)), 6);
const fridayLead = friday[0];
const wardrobe = fill(byCategory('style'), 5, hero);
const dining = fill(byCategory('dining'), 4, hero);
const stays = fill(byCategory('travel'), 4, hero);
const beauty = fill(byCategory('beauty'), 5, hero);
const people = fill(byCategory('people'), 4, hero);
const majlis = fill(cards.filter((card) => ['culture', 'living', 'guides', 'people'].includes(card.category)), 3, hero);
---

<BaseLayout
	title="Arahkaii — Asia's modern-luxury edit, modestly told"
	description="Asia's modern-luxury edit, modestly told — considered reporting on style, beauty, halal dining, travel and the people shaping modern Asian luxury."
>
	<div class="home-shell">
		{heroLead && hero.length >= 3 && <section class="home-hero" aria-labelledby="hero-title">
			<div class="home-hero__grid">{hero.map((card) => <a class="home-hero__image media" href={card.url} aria-label={card.title}><Image src={card.image} alt={card.heroCaption || card.title} loading="eager" widths={[480,720,960]} sizes="(max-width:700px) 100vw, 33vw" /></a>)}</div>
			<div class="home-hero__story"><p class="home-kicker">The cover story</p><h2 id="hero-title"><a href={heroLead.url}>{heroLead.title}</a></h2><p>{heroLead.standfirst}</p><a class="home-link" href={heroLead.url}>Read the essay <span aria-hidden="true">→</span></a></div>
		</section>}

		{fridayLead && <section class="home-panel friday-edit" aria-labelledby="friday-title">
			<h2 class="home-section-title" id="friday-title">The Friday edit</h2>
			<div class="friday-edit__grid">
				<article class="friday-lead"><a class="media friday-lead__image" href={fridayLead.url}><Image src={fridayLead.image} alt={fridayLead.heroCaption || fridayLead.title} widths={[640,960,1280]} sizes="(max-width:800px) 100vw, 48vw" /></a><p class="home-kicker">Lead essay</p><h3><a href={fridayLead.url}>{fridayLead.title}</a></h3><p class="friday-lead__dek">{fridayLead.standfirst}</p><p class="home-meta">By {fridayLead.authorName} <span>{date(fridayLead)}</span></p></article>
				<div class="friday-briefs" aria-label="More from the Friday edit">{friday.slice(1).map((card) => <article class="mini-story"><a class="media mini-story__image" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" widths={[120,240]} sizes="84px" /></a><div><p class="home-kicker">Brief</p><h3><a href={card.url}>{card.title}</a></h3><p class="home-meta">{card.byline} · {date(card)}</p></div></article>)}</div>
				<aside class="verified-card"><p class="home-kicker">Arahkaii verified <span aria-hidden="true">●</span></p><div><h3>Trusted standards.<br />Conscious choices.</h3><p>Independent guidance for dining, travel and wellness — considered through a Muslim lens.</p></div><a class="home-link" href="/guides">Explore verified <span aria-hidden="true">→</span></a></aside>
			</div>
		</section>}

		<nav class="home-franchises" aria-label="Arahkaii signature editions">
			<a href="/franchises/arahkaii-verified/"><span>01</span><div><p>Arahkaii Verified</p><small>Evidence-led recommendations</small></div></a>
			<a href="/franchises/the-majlis/"><span>02</span><div><p>The Majlis</p><small>Essays and conversations</small></div></a>
			<a href="/franchises/city-guides/"><span>03</span><div><p>City guides</p><small>Prayer-aware travel</small></div></a>
			<a href="/franchises/the-modest-list/"><span>04</span><div><p>The Modest List</p><small>Wardrobe and craft</small></div></a>
		</nav>

		<section class="home-trio" aria-label="Arahkaii guides">
			<div class="compact-module"><h2 class="home-section-title">Modest wardrobe</h2>{wardrobe[0] && <a class="media compact-module__lead portrait" href={wardrobe[0].url}><Image src={wardrobe[0].image} alt={wardrobe[0].heroCaption || wardrobe[0].title} widths={[420,720]} sizes="(max-width:800px) 100vw, 30vw" /></a>}<div class="compact-list">{wardrobe.slice(1).map((card) => <article><a class="media" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" widths={[160,320]} sizes="112px" /></a><h3><a href={card.url}>{card.title}</a></h3></article>)}</div><a class="home-link" href="/style">Explore style <span aria-hidden="true">→</span></a></div>
			<div class="compact-module"><h2 class="home-section-title">Halal status checked</h2>{dining[0] && <a class="media compact-module__lead landscape" href={dining[0].url}><Image src={dining[0].image} alt={dining[0].heroCaption || dining[0].title} widths={[480,800]} sizes="(max-width:800px) 100vw, 30vw" /></a>}<div class="place-list">{dining.map((card) => <a href={card.url}><span>{card.title}</span><small>Guide · {date(card)}</small></a>)}</div><a class="home-link" href="/dining">View all dining guides <span aria-hidden="true">→</span></a></div>
			<div class="compact-module stays-module"><h2 class="home-section-title">Prayer-aware stays</h2>{stays[0] && <a class="media compact-module__lead landscape" href={stays[0].url}><Image src={stays[0].image} alt={stays[0].heroCaption || stays[0].title} widths={[480,800]} sizes="(max-width:800px) 100vw, 30vw" /></a>}<div class="compact-list compact-list--travel">{stays.slice(1).map((card) => <article><a class="media" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" widths={[160,320]} sizes="112px" /></a><div><h3><a href={card.url}>{card.title}</a></h3><p>{card.standfirst}</p></div></article>)}</div><a class="home-link" href="/travel">Explore stays <span aria-hidden="true">→</span></a></div>
		</section>

		<section class="home-duo" aria-label="Beauty and people">
			<div class="compact-module beauty-module"><h2 class="home-section-title">Beauty for the tropics</h2><div class="beauty-module__grid">{beauty[0] && <a class="media beauty-module__lead" href={beauty[0].url}><Image src={beauty[0].image} alt={beauty[0].heroCaption || beauty[0].title} widths={[420,720]} sizes="(max-width:800px) 100vw, 28vw" /></a>}<div class="compact-list">{beauty.slice(1).map((card) => <article><a class="media" href={card.url} tabindex="-1" aria-hidden="true"><Image src={card.image} alt="" widths={[160,320]} sizes="112px" /></a><h3><a href={card.url}>{card.title}</a></h3></article>)}</div></div><a class="home-link" href="/beauty">Explore beauty <span aria-hidden="true">→</span></a></div>
			<div class="compact-module people-module"><h2 class="home-section-title">People shaping Asia</h2><div class="people-grid">{people.map((card) => <article><a class="media" href={card.url}><Image src={card.image} alt={card.heroCaption || card.title} widths={[320,560]} sizes="(max-width:700px) 50vw, 18vw" /></a><h3><a href={card.url}>{card.title}</a></h3><p class="home-meta">{card.byline}</p></article>)}</div><a class="home-link" href="/people">Meet the editors &amp; contributors <span aria-hidden="true">→</span></a></div>
		</section>

		{majlis.length >= 3 && <section class="majlis" aria-labelledby="majlis-title"><div class="majlis__head"><div><h2 id="majlis-title">The Majlis</h2><p>Long reads for a slower kind of luxury.</p></div><a class="home-link" href="/franchises/the-majlis/">Visit the Majlis <span aria-hidden="true">→</span></a></div><div class="majlis__grid">{majlis.map((card) => <article><a class="media" href={card.url}><Image src={card.image} alt={card.heroCaption || card.title} widths={[480,800]} sizes="(max-width:700px) 100vw, 31vw" /></a><p class="home-kicker">Essay</p><h3><a href={card.url}>{card.title}</a></h3><p>{card.standfirst}</p><p class="home-meta">By {card.authorName} <span>{card.readingMinutes} min read</span></p></article>)}</div></section>}

		<section class="home-newsletter" aria-labelledby="newsletter-title"><h2 id="newsletter-title">Sundays,<br />considered.</h2><div><p>Essays, edits and invitations for a life well-lived — delivered weekly.</p><NewsletterSignup class="home-newsletter__form" source="homepage"><p slot="note" class="field-note">By subscribing, you agree to receive emails from Arahkaii.</p></NewsletterSignup></div>{beauty[0] && <div class="media home-newsletter__image"><Image src={beauty[0].image} alt="A considered Sunday with Arahkaii" widths={[420,720]} sizes="28vw" /></div>}</section>
	</div>
</BaseLayout>
