---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import Hero from '../components/home/Hero.astro';
import EditLane from '../components/home/EditLane.astro';
import FeaturePair from '../components/home/FeaturePair.astro';
import Interlude from '../components/home/Interlude.astro';
import Mosaic from '../components/home/Mosaic.astro';
import Spotlight from '../components/home/Spotlight.astro';
import MostRead from '../components/MostRead.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCards, type PostCard } from '../lib/articles';

// Editorial-rhythm homepage: every section differs in shape from its
// neighbours (image ↔ type, varied scale/density), punctuated once by a
// full-bleed aubergine interlude. Image-card sections never repeat a story —
// a `used` set reserves cards as we go; the most-read text list may overlap.
const cards = await getCards();
const used = new Set<string>();
const reserve = (cs: PostCard[]) => {
	cs.forEach((c) => used.add(c.id));
	return cs;
};
const free = (pred: (c: PostCard) => boolean = () => true, n = Infinity) =>
	cards.filter((c) => !used.has(c.id) && pred(c)).slice(0, n);

const hero = reserve(free(() => true, 1))[0];
const edit = reserve(free(() => true, 3));
const fp = reserve(free(() => true, 3));
const featureLead = fp[0];
const featureRest = fp.slice(1, 3);

const styleLane = reserve(free((c) => c.category === 'style', 6));
const cultureLane = reserve(free((c) => c.category === 'culture', 6));

const pick = reserve(
	free((c) => ['guides', 'people', 'dining', 'travel', 'living'].includes(c.category), 1)
		.concat(free(() => true, 1))
		.slice(0, 1),
)[0];

const spotlight = reserve(
	free((c) => ['guides', 'culture', 'living'].includes(c.category), 1)
		.concat(free(() => true, 1))
		.slice(0, 1),
)[0];

const thinCats = ['dining', 'travel', 'living', 'people'];
const mosaicItems = reserve(
	[...free((c) => thinCats.includes(c.category)), ...free()].slice(0, 7),
);

const mostRead = cards.slice(0, 6); // recency; text list, may overlap features
---

<BaseLayout title="Arahkaii — Asia's modern-luxury edit, modestly told" overHero={true}>
	{hero && <Hero card={hero} />}

	<main class="wrap">
		{
			edit.length > 0 && (
				<section class="sec">
					<div class="sec-head rise">
						<span class="eyebrow">The Edit</span>
						<span class="meta">Selected this week</span>
					</div>
					<div class="edit-grid">
						{edit.map((c) => (
							<StoryCard
								class="rise"
								href={c.url}
								title={c.title}
								byline={`${c.byline} · ${c.categoryLabel}`}
								image={c.image}
								tone={c.tone}
								ratio="4x5"
							/>
						))}
					</div>
				</section>
			)
		}

		{featureLead && <FeaturePair lead={featureLead} rest={featureRest} />}

		{styleLane.length >= 2 && (
			<section class="sec" style="padding-top:96px">
				<EditLane title="Style" href="/style" items={styleLane} />
			</section>
		)}

		<Interlude />

		{cultureLane.length >= 2 && (
			<section class="sec">
				<EditLane title="Culture" href="/culture" items={cultureLane} />
			</section>
		)}

		{mostRead.length > 0 && <MostRead items={mostRead} pick={pick} />}

		{mosaicItems.length > 0 && <Mosaic items={mosaicItems} />}

		{
			spotlight && (
				<section class="sec">
					<div class="chapter ornament rise"><span>✦</span></div>
					<Spotlight card={spotlight} />
				</section>
			)
		}

		<section class="sec">
			<div class="rule"></div>
			<div class="news-line" style="padding-top:80px">
				<p class="sentence">Sign up for Arahkaii Weekly. Sundays, in your inbox.</p>
				<NewsletterSignup />
			</div>
		</section>
	</main>
</BaseLayout>
