---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCards } from '../lib/articles';
import { organizationSchema, websiteSchema, collectionPageSchema } from '../lib/seo';

// The contributors index — a quiet directory of the writers behind Arahkaii,
// each linking to their author page. Grows as the masthead does.
const authors = await getCollection('authors');
const cards = await getCards();
const countById = new Map<string, number>();
for (const c of cards) countById.set(c.author, (countById.get(c.author) ?? 0) + 1);

const contributors = authors
	.map((a) => ({ ...a, count: countById.get(a.id) ?? 0 }))
	.sort((a, b) => a.data.name.localeCompare(b.data.name));

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	collectionPageSchema({
		name: 'Contributors — Arahkaii',
		url: canonical,
		description: 'The writers behind Arahkaii.',
	}),
];
---

<BaseLayout
	title="Contributors — Arahkaii"
	description="The writers behind Arahkaii — reporting a quieter idea of modern luxury across Asia."
	activeCategory="People"
	jsonLd={jsonLd}
>
	<main class="wrap">
		<header class="cb-head">
			<Breadcrumbs class="page-crumbs" items={[{ name: 'Arahkaii', href: '/' }, { name: 'Contributors' }]} />
			<span class="eyebrow">The Masthead</span>
			<h1 class="cb-title">Contributors</h1>
			<p class="cb-dek">
				The writers behind Arahkaii — reporting a quieter idea of modern luxury, modestly told,
				across Asia.
			</p>
		</header>

		<div class="cb-list">
			{
				contributors.map((a) => (
					<a class="contributor" href={`/authors/${a.id}`}>
						{a.data.avatar ? (
							<div class="img real r-1x1 cb-portrait blurup">
								<Image src={a.data.avatar} alt={a.data.name} width={240} height={240} />
							</div>
						) : (
							<div class="img ph tone-b r-1x1 cb-portrait blurup" />
						)}
						<div class="cb-body">
							<h2 class="cb-name">{a.data.name}</h2>
							<p class="cb-role">{a.data.role}</p>
							<p class="cb-bio">{a.data.bio}</p>
							<span class="cb-more">
								{a.count} {a.count === 1 ? 'story' : 'stories'} · Read profile
							</span>
						</div>
					</a>
				))
			}
		</div>
	</main>
</BaseLayout>
