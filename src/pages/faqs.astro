---
import PageLayout from '../layouts/PageLayout.astro';
import { faqSchema } from '../lib/seo';

const faqs = [
	{
		q: 'What is Arahkaii?',
		a: "Arahkaii is an Asian modern-luxury publication across eight pillars — Style, Beauty, Dining, Travel, Living, People, Culture and Guides — from Seoul runways to Singapore's fine-dining rooms to the founders quietly reshaping Asian luxury.",
	},
	{
		q: 'Who is Arahkaii for?',
		a: 'Readers who want modern luxury treated with care and restraint — considered reporting and recommendations they can trust, across style, beauty, dining, travel and culture.',
	},
	{
		q: 'What are the eight editorial pillars?',
		a: "Style (modern fashion through an Asian lens), Beauty (Asian skin and science), Dining (the kitchens and tables worth booking, verified per venue), Travel (city guides at locals' granularity), Living (home and conscious luxury), People (founders and designers), Culture (the ideas and movements shaping Asian luxury), and Guides (reference content built to be bookmarked).",
	},
	{
		q: 'Does Arahkaii cover alcohol, bars or nightlife?',
		a: 'No. We never produce alcohol, bar, nightclub or nightlife content — a considered choice about the kind of luxury we cover. Our dining and travel recommendations are verified per venue.',
	},
	{
		q: 'Who produces the content?',
		a: 'Our in-house editorial team, working with industry experts, brand founders and contributors who understand the considered-luxury reader. Every piece passes an editorial-standards and anti-AI-slop check before publication.',
	},
	{
		q: 'Can brands or creators contribute?',
		a: 'Yes — for features, founder profiles and special projects that align with our values of craft, ethics and Asia-rooted storytelling. Write to onnifyworks@gmail.com or see our Join us page.',
	},
	{
		q: 'How often do you publish?',
		a: "We are building towards two or three strong stories a week across our focus pillars. Arahkaii Weekly gathers the best work for Sunday rather than publishing for volume.",
	},
	{
		q: 'Do you feature Singapore brands?',
		a: 'Yes. Singapore and Southeast Asia are central to our coverage, alongside Korea, Japan, Indonesia, Malaysia and the wider Asian luxury landscape.',
	},
	{
		q: 'Is Arahkaii free to read?',
		a: 'Yes. All editorial content is freely accessible worldwide, with no subscription fee.',
	},
	{
		q: 'How do you choose brands and topics?',
		a: 'By three filters: quality (made with care, built to last), ethics (how it was made, and by whom) and cultural fit (does it speak to the Asian modern-luxury reader). Dining, Travel and Guides recommendations are verified per venue.',
	},
	{
		q: 'Can I subscribe for updates?',
		a: 'Yes — Arahkaii Weekly brings one lead story and a short edit across style, beauty, dining, travel and culture to your inbox on Sundays.',
	},
	{
		q: 'Do you offer advertising or sponsored content?',
		a: 'Yes, within our editorial guidelines — and never for alcohol or nightlife. Sponsored work is written in the pillar voice and clearly labelled. See our Advertise page.',
	},
	{
		q: 'How do you keep editorial independence?',
		a: 'Sponsored content is always labelled, and brand partnerships never override our editorial and quality standards.',
	},
];
---

<PageLayout
	title="FAQs"
	eyebrow="Good to know"
	dek="What Arahkaii is, who it's for, and how we work."
	description="Frequently asked questions about Arahkaii — our eight pillars, editorial standards, contributing, advertising and more."
	extraSchema={[faqSchema(faqs)]}
>
	<div class="faq-list">
		{
			faqs.map((f, i) => (
				<details class="faq-item" open={i === 0}>
					<summary>{f.q}</summary>
					<p class="faq-a">{f.a}</p>
				</details>
			))
		}
	</div>
</PageLayout>
