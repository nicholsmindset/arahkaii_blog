---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { Image } from 'astro:assets';
import subscribeImage from '../assets/blog-placeholder-5.jpg';

// Focused signup hero — footer suppressed for a single-minded page.
---

<BaseLayout title="Arahkaii Weekly — Subscribe" noFooter={true}>
	<div class="sub-wrap">
		<Breadcrumbs center class="page-crumbs" items={[{ name: 'Arahkaii', href: '/' }, { name: 'Subscribe' }]} />
		<span class="eyebrow sub-eyebrow">The Newsletter</span>
		<h1 class="sub-h1">Arahkaii Weekly</h1>
		<p class="sub-promise">
			One edit, gathered slowly and sent on Sundays — the week's most considered
			things, in your inbox.
		</p>

		<ul class="sub-inside">
			<li>The one story worth your Sunday — chosen, not aggregated.</li>
			<li>A short edit across style, beauty, dining, travel and culture.</li>
			<li>No noise, no daily pings. One email a week, and nothing else.</li>
		</ul>

		<NewsletterSignup class="sub-form" source="subscribe-page">
			<p slot="note" class="sub-note field-note">
				Sundays. One edit.<br />Free, and unsubscribe anytime.
			</p>
		</NewsletterSignup>

		<a class="link-more" href="/latest" style="margin-top:30px">See the latest</a>

		<figure class="sub-image">
			<div class="img real r-16x9 blurup in">
				<Image src={subscribeImage} alt="A quiet Sunday reading table in soft natural light" widths={[640, 960, 1280]} sizes="(max-width:760px) 100vw, 720px" />
			</div>
		</figure>
	</div>
</BaseLayout>
