---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { Image } from 'astro:assets';
import subscribeImage from '../assets/brand-subscribe.png';

// Focused signup hero — footer suppressed for a single-minded page.
---

<BaseLayout
	title="Arahkaii Weekly — Subscribe"
	description="Subscribe to Arahkaii Weekly — one considered email every Sunday with the week's best story and a short edit across style, beauty, dining and travel. No noise."
	noFooter={true}
>
	<div class="sub-wrap">
		<Breadcrumbs center class="page-crumbs" items={[{ name: 'Arahkaii', href: '/' }, { name: 'Subscribe' }]} />
		<span class="eyebrow sub-eyebrow">The Newsletter</span>
		<h1 class="sub-h1">Arahkaii Weekly</h1>
		<p class="sub-promise">
			One edit, gathered slowly and sent on Sundays — the week's most considered
			things, in your inbox.
		</p>

		<ul class="sub-inside">
			<li>The one story worth your Sunday — chosen, not aggregated.</li>
			<li>A short edit across style, beauty, dining, travel and culture.</li>
			<li>No noise, no daily pings. One email a week, and nothing else.</li>
		</ul>

		<NewsletterSignup class="sub-form" source="subscribe-page" showSampleLink={false}>
			<p slot="note" class="sub-note field-note">
				Sundays. One edit.<br />Free, and unsubscribe anytime.
			</p>
		</NewsletterSignup>

		<div style="display:flex;gap:24px;justify-content:center;flex-wrap:wrap;margin-top:30px">
			<a class="link-more" href="/newsletter/sample/">Read a sample edition</a>
			<a class="link-more" href="/latest/">See the latest stories</a>
		</div>

		<figure class="sub-image">
			<div class="img real r-16x9 blurup in">
				<Image src={subscribeImage} alt="Arahkaii Weekly — one considered email, no noise — on an aubergine field" widths={[640, 960, 1280]} sizes="(max-width:760px) 100vw, 720px" />
			</div>
		</figure>
	</div>
</BaseLayout>
