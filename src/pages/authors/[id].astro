---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getCards } from '../../lib/articles';
import { fmtDate } from '../../lib/format';
import {
	SITE,
	organizationSchema,
	websiteSchema,
	personSchema,
	breadcrumbSchema,
} from '../../lib/seo';

export async function getStaticPaths() {
	const authors = await getCollection('authors');
	return authors.map((author) => ({
		params: { id: author.id },
		props: { author },
	}));
}

const { author } = Astro.props;
const a = author.data;
const firstName = a.name.split(' ')[0];

const work = (await getCards()).filter((c) => c.author === author.id);
const count = work.length;

// — SEO / Person schema —
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
let avatarUrl: string | undefined;
if (a.avatar) {
	const img = await getImage({ src: a.avatar, width: 600, height: 600, format: 'jpg' });
	avatarUrl = new URL(img.src, Astro.site).toString();
}
// Meta descriptions truncate around 160 chars in search results; the full bio
// stays on-page and in Person schema context via the page itself.
const metaDescription = a.bio.length > 158 ? `${a.bio.slice(0, a.bio.lastIndexOf(' ', 155))}…` : a.bio;
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	personSchema({
		name: a.name,
		jobTitle: a.role,
		description: a.bio,
		url: canonical,
		image: avatarUrl,
		sameAs: a.sameAs,
	}),
	breadcrumbSchema([
		{ name: SITE.name, url: SITE.url },
		{ name: 'Contributors', url: new URL('/contributors/', SITE.url).toString() },
		{ name: a.name, url: canonical },
	]),
];
---

<BaseLayout
	title={`${a.name} — Arahkaii`}
	description={metaDescription}
	activeCategory="People"
	image={avatarUrl}
	imageWidth={600}
	imageHeight={600}
	jsonLd={jsonLd}
>
	<div class="wrap">
		<header class="author-head">
			<div>
				<Breadcrumbs
					schema={false}
					class="page-crumbs"
					items={[
						{ name: 'Arahkaii', href: '/' },
						{ name: 'Contributors', href: '/contributors/' },
						{ name: a.name },
					]}
				/>
				<h1 class="ah-name">{a.name}</h1>
				<p class="ah-role">{a.role}</p>
				<p class="ah-bio">{a.bio}</p>
				{a.expertise?.length && <ul class="author-expertise" aria-label="Areas of expertise">{a.expertise.map((item) => <li>{item}</li>)}</ul>}
				<div style="margin-top:30px">
					<button
						class="follow-btn js-follow"
						type="button"
						data-follow-id={author.id}
						data-follow-name={firstName}
					>
						<span class="fb-plus" aria-hidden="true">+</span>
						<span class="fb-label">Follow {firstName}</span>
					</button>
				</div>
				<div class="ah-socials">
					<a href="/subscribe/">Newsletter</a>
					{a.sameAs?.map((url) => <a href={url} rel="me noopener" target="_blank">Profile</a>)}
					<a href="https://www.instagram.com/arahkaii/" rel="me">Instagram</a>
					<a href="https://www.x.com/arahkaii" rel="me">X / Twitter</a>
				</div>
			</div>
			{
				a.avatar ? (
					<div class="img real r-4x5 ah-portrait blurup in">
						<Image src={a.avatar} alt={a.name} />
					</div>
				) : (
					<div class="img ph tone-b r-4x5 ah-portrait blurup in">
						<span class="lab">Portrait — {a.name} · 4:5</span>
					</div>
				)
			}
		</header>

		<section class="author-work">
			<div class="aw-head">
				<h2 class="eyebrow">Selected writing</h2>
				<span class="meta">{count} {count === 1 ? 'story' : 'stories'}</span>
			</div>
			{
				count > 0 ? (
					<div class="aw-grid">
						{work.map((c) => (
							<StoryCard
								href={c.url}
								title={c.title}
								byline={`${c.categoryLabel} · ${fmtDate(c.date)}`}
								image={c.image}
								tone={c.tone}
								ratio="3x2"
								category={c.category}
							/>
						))}
					</div>
				) : (
					<p class="lede" style="padding:24px 0 48px">
						{firstName}'s first pieces are in the works — commissioned, reported and on their way through review.
					</p>
				)
			}
		</section>
	</div>
</BaseLayout>
