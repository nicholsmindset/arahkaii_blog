---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCards, type PostCard } from '../../lib/articles';
import { cap, prettifyTag } from '../../lib/format';
import { CATEGORIES } from '../../lib/taxonomy';
import { SITE, organizationSchema, websiteSchema, collectionPageSchema, breadcrumbSchema, itemListSchema } from '../../lib/seo';

// Category archive — v2: no-image hero band + filter chips, full-width lead,
// then an alternating "river" (A 4-4-4 → B 6+stacked-two → C 6-6 portrait →
// typographic interlude → D 3-3-3-3, repeating) so the page never repeats a
// rhythm. One static page per category in the schema enum.
const DEKS: Record<string, string> = {
	style: 'Considered fashion, woven across Asia — from Lahore ateliers to Seoul studios.',
	beauty: 'Skincare science, and the rituals behind a considered face.',
	dining: 'The kitchens, tables and chefs worth crossing town for.',
	travel: 'Slow journeys, soft light, the unhurried itinerary.',
	culture: 'Architecture, craft, literature and the long view.',
	living: 'Homes built around light, family and quiet.',
	people: 'The makers, and the long apprenticeships behind them.',
	guides: 'Considered lists, sourced and credited with care.',
};

// Search-facing descriptions (140–160 chars); the DEKS above stay as the
// on-page poetry.
const META: Record<string, string> = {
	style: 'Modest fashion and Asian style, considered — designer profiles, fashion-week reporting, quiet luxury and wardrobe guides from Seoul to Jakarta to Lahore.',
	beauty: 'Asian beauty, edited with care — K-beauty and C-beauty brand guides, skincare science and makeup that survives tropical humidity.',
	dining: 'Dining across Asia, considered — fine-dining guides, restaurant reporting and the kitchens worth travelling for, verified per venue.',
	travel: 'Luxury travel across Asia — neighbourhood-led city guides, considered hotels and unhurried itineraries from Singapore to the region beyond.',
	culture: 'Asian culture through a considered lens — architecture, craft, art, literature and the long view on the ideas shaping modern Asian luxury.',
	living: 'Modern Asian living, modestly told — homes built around light and family, conscious consumption and the quiet rituals of a considered life.',
	people: 'The people shaping modern Asian luxury — founders, designers, chefs and makers, and the long apprenticeships behind beautiful things.',
	guides: 'Arahkaii guides — considered, sourced and credited lists across style, beauty, dining and travel, checked and refreshed by our editors.',
};

export async function getStaticPaths() {
	return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const label = cap(category!);
const dek = DEKS[category!] ?? '';
const meta = META[category!] ?? dek;

const all = await getCards();
const cards = all.filter((c) => c.category === category);
const lead = cards[0];
const pool = cards.slice(1);
// Thin categories: cross-category stories render in their own labelled
// "Elsewhere in Arahkaii" section below the river — never mixed into it
// unlabelled.
const elsewhere = pool.length < 4 ? all.filter((c) => c.category !== category).slice(0, 6) : [];

// filter chips — most common tags. "All" shows the editorial river; a tag chip
// swaps in a simple filtered grid of matching stories (same interaction
// grammar as /latest).
const counts = new Map<string, number>();
for (const c of cards) for (const t of c.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const topTags = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([t]) => t);
const prettify = prettifyTag;
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// build the alternating river
type Row =
	| { type: 'A' | 'C' | 'D'; cards: PostCard[] }
	| { type: 'B'; cards: PostCard[] }
	| { type: 'Q'; quote: PostCard };
const plan: Array<'A' | 'B' | 'C' | 'D'> = ['A', 'B', 'C', 'D'];
const sizes: Record<string, number> = { A: 3, B: 3, C: 2, D: 4 };
const rows: Row[] = [];
let qi = 0;
let queue = [...pool];
let quoteIx = 0;
while (queue.length) {
	const t = plan[qi % plan.length];
	if (t === 'D' && rows.length) rows.push({ type: 'Q', quote: cards[quoteIx++ % Math.max(cards.length, 1)] ?? lead });
	const slice = queue.splice(0, sizes[t]);
	if (!slice.length) break;
	rows.push({ type: t, cards: slice });
	qi++;
}

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	collectionPageSchema({ name: `${label} — Arahkaii`, url: canonical, description: meta }),
	breadcrumbSchema([
		{ name: SITE.name, url: SITE.url },
		{ name: label, url: canonical },
	]),
];
if (cards.length)
	jsonLd.push(
		itemListSchema(
			`${label} — Arahkaii`,
			cards.map((c) => ({ name: c.title, description: c.standfirst, url: new URL(c.url, SITE.url).toString() })),
			canonical,
		),
	);
---

<BaseLayout title={`${label} — Arahkaii`} description={meta} activeCategory={label} noindex={cards.length === 0} jsonLd={jsonLd}>
	<!-- HERO BAND (no image) -->
	<section class="cat-hero">
		<div class="wrap">
			<h1 class="h1 reveal">{label}</h1>
			<p class="dek reveal" data-stagger="60" style="max-width:32ch;margin:20px auto 0">{dek}</p>
			{
				topTags.length > 0 && (
					<div class="chips reveal" data-stagger="120" role="group" aria-label={`Filter ${label} stories by theme`}>
						<button type="button" class="chip" data-cat-chip="all" aria-pressed="true">All</button>
						{topTags.map((t) => (
							<button type="button" class="chip" data-cat-chip={t} aria-pressed="false">{prettify(t)}</button>
						))}
					</div>
				)
			}
		</div>
	</section>

	<!-- EDITORIAL VIEW (lead + river) — hidden while a tag chip is active -->
	<div data-cat-river>
	<!-- LEAD ROW (full-width 3:2) -->
	{
		lead && (
			<section class="section--tight" style="padding-top:0">
				<div class="wrap">
					<a class="hl-link reveal" href={lead.url} style="display:block">
						<div class="media ar-3-2">
							<Image src={lead.image} alt={lead.title} loading="eager" fetchpriority="high" widths={[768, 1280, 1920]} sizes="(max-width:1440px) 100vw, 1280px" />
						</div>
						<div class="grid" style="margin-top:32px">
							<div style="grid-column:1 / 9">
								<p class="kicker11" style="margin-bottom:14px">{lead.tags[0] ? prettify(lead.tags[0]) : lead.categoryLabel}</p>
								<h2 class="h2"><span class="hl">{lead.title}</span></h2>
							</div>
							<p class="dek" style="grid-column:1 / 8;font-size:var(--body);font-style:normal;color:var(--ink-2);margin-top:16px">{lead.standfirst}</p>
						</div>
					</a>
				</div>
			</section>
		)
	}

	<!-- ARTICLE RIVER -->
	<div class="wrap">
		{
			rows.map((row) => {
				if (row.type === 'Q') {
					return (
						<section style="padding-block:clamp(48px,7vw,96px)">
							<div class="grid">
								<blockquote class="reveal category-quote">
									<p class="category-quote__text">“{row.quote.standfirst}”</p>
									<p class="kicker11 category-quote__source">— From “{row.quote.title}”</p>
								</blockquote>
							</div>
						</section>
					);
				}
				if (row.type === 'A') {
					const span = ['1 / 5', '5 / 9', '9 / 13'];
					return (
						<section class="section--tight">
							<hr class="rule reveal" style="margin-bottom:40px" />
							<div class="grid">
								{row.cards.map((c, i) => (
									<a class="card hl-link reveal" href={c.url} data-stagger={i ? String(i * 60) : undefined} style={`grid-column:${span[i]}`}>
										<div class="media ar-3-2"><Image src={c.image} alt={c.title} widths={[400, 700]} sizes="(max-width:860px) 100vw, 31vw" /></div>
										<p class="kicker11" style="margin:14px 0 6px">{c.tags[0] ? prettify(c.tags[0]) : c.categoryLabel}</p>
										<h3 class="h5"><span class="hl">{c.title}</span></h3>
									</a>
								))}
							</div>
						</section>
					);
				}
				if (row.type === 'B') {
					const big = row.cards[0];
					const minis = row.cards.slice(1, 3);
					return (
						<section class="section--tight">
							<div class="grid">
								<a class="card hl-link reveal" href={big.url} style="grid-column:1 / 7">
									<div class="media ar-4-5"><Image src={big.image} alt={big.title} widths={[500, 800]} sizes="(max-width:860px) 100vw, 46vw" /></div>
									<p class="kicker11" style="margin:16px 0 6px">{big.tags[0] ? prettify(big.tags[0]) : big.categoryLabel}</p>
									<h3 class="h4"><span class="hl">{big.title}</span></h3>
								</a>
								<div style="grid-column:7 / 13; display:flex; flex-direction:column; gap:32px; justify-content:center">
									{minis.map((c, i) => (
										<>
											{i > 0 && <hr class="rule" />}
											<a class="card hl-link reveal" data-stagger={String((i + 1) * 60)} href={c.url} style="display:grid;grid-template-columns:1fr 1.4fr;gap:20px;align-items:center">
												<div class="media ar-1-1"><Image src={c.image} alt={c.title} widths={[200, 360]} sizes="160px" /></div>
												<div>
													<p class="kicker11" style="margin-bottom:6px">{c.tags[0] ? prettify(c.tags[0]) : c.categoryLabel}</p>
													<h3 class="h5"><span class="hl">{c.title}</span></h3>
												</div>
											</a>
										</>
									))}
								</div>
							</div>
						</section>
					);
				}
				if (row.type === 'C') {
					const span = ['1 / 7', '7 / 13'];
					return (
						<section class="section--tight">
							<div class="grid">
								{row.cards.map((c, i) => (
									<a class="card hl-link reveal" href={c.url} data-stagger={i ? '60' : undefined} style={`grid-column:${span[i]}`}>
										<div class="media ar-3-4"><Image src={c.image} alt={c.title} widths={[500, 800]} sizes="(max-width:860px) 100vw, 46vw" /></div>
										<p class="kicker11" style="margin:16px 0 6px">{c.tags[0] ? prettify(c.tags[0]) : c.categoryLabel}</p>
										<h3 class="h4"><span class="hl">{c.title}</span></h3>
									</a>
								))}
							</div>
						</section>
					);
				}
				// D — 3-3-3-3 squares
				const span = ['1 / 4', '4 / 7', '7 / 10', '10 / 13'];
				return (
					<section class="section--tight" style="padding-top:0">
						<div class="grid">
							{row.cards.map((c, i) => (
								<a class="card hl-link reveal" href={c.url} data-stagger={i ? String(i * 60) : undefined} style={`grid-column:${span[i]}`}>
									<div class="media ar-1-1"><Image src={c.image} alt={c.title} widths={[300, 500]} sizes="(max-width:860px) 50vw, 23vw" /></div>
									<p class="kicker11" style="margin:12px 0 6px">{c.tags[0] ? prettify(c.tags[0]) : c.categoryLabel}</p>
									<h3 class="h5"><span class="hl">{c.title}</span></h3>
								</a>
							))}
						</div>
					</section>
				);
			})
		}

		{!lead && <p class="lede" style="padding:48px 0">No stories here yet — check back soon.</p>}

		{
			elsewhere.length > 0 && (
				<section class="section--tight" aria-labelledby="elsewhere-title">
					<hr class="rule" style="margin-bottom:32px" />
					<h2 class="eyebrow eyebrow--emerald" id="elsewhere-title" style="margin-bottom:36px">Elsewhere in Arahkaii</h2>
					<div class="latest-grid">
						{elsewhere.map((c) => (
							<article class="latest-card">
								<a class="media latest-card__image" href={c.url}>
									<Image src={c.image} alt={c.title} widths={[400, 700]} sizes="(max-width:860px) 100vw, 31vw" loading="lazy" />
								</a>
								<div class="latest-card__copy">
									<p class="latest-card__top">
										<span>{c.categoryLabel}</span>
										<time datetime={c.date.toISOString()}>{dateFormat.format(c.date)}</time>
									</p>
									<h3><a href={c.url}>{c.title}</a></h3>
									<p>{c.standfirst}</p>
								</div>
							</article>
						))}
					</div>
				</section>
			)
		}

		<div class="loadmore" style="padding-bottom:96px">
			<a class="tlink" href="/latest">Load more</a>
		</div>
	</div>
	</div>

	<!-- FILTERED VIEW — simple grid shown when a tag chip is active -->
	{
		topTags.length > 0 && (
			<section class="wrap" data-cat-filtered hidden style="padding-bottom:96px">
				<div class="latest-grid">
					{cards.map((c) => (
						<article class="latest-card" data-cat-tags={c.tags.join('|')}>
							<a class="media latest-card__image" href={c.url}>
								<Image src={c.image} alt={c.title} widths={[400, 700]} sizes="(max-width:860px) 100vw, 31vw" />
							</a>
							<div class="latest-card__copy">
								<p class="latest-card__top">
									<span>{c.tags[0] ? prettify(c.tags[0]) : c.categoryLabel}</span>
									{c.date && <time datetime={c.date.toISOString()}>{dateFormat.format(c.date)}</time>}
								</p>
								<h3><a href={c.url}>{c.title}</a></h3>
								<p>{c.standfirst}</p>
							</div>
						</article>
					))}
				</div>
				<p class="latest-empty" data-cat-empty hidden>
					No stories carry this theme yet.
				</p>
				<p class="sr-only" role="status" data-cat-status></p>
			</section>
		)
	}

	<script>
		function wireCategoryChips() {
			const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-chip]'));
			const river = document.querySelector<HTMLElement>('[data-cat-river]');
			const filtered = document.querySelector<HTMLElement>('[data-cat-filtered]');
			if (!chips.length || !river || !filtered || filtered.dataset.wired) return;
			filtered.dataset.wired = '1';
			const cards = Array.from(filtered.querySelectorAll<HTMLElement>('[data-cat-tags]'));
			const empty = filtered.querySelector<HTMLElement>('[data-cat-empty]');
			const status = filtered.querySelector<HTMLElement>('[data-cat-status]');
			chips.forEach((chip) => chip.addEventListener('click', () => {
				const tag = chip.dataset.catChip || 'all';
				chips.forEach((item) => item.setAttribute('aria-pressed', String(item === chip)));
				const showRiver = tag === 'all';
				river.hidden = !showRiver;
				filtered.hidden = showRiver;
				if (showRiver) {
					if (status) status.textContent = 'Showing all stories.';
					return;
				}
				let visible = 0;
				cards.forEach((card) => {
					const show = (card.dataset.catTags || '').split('|').includes(tag);
					card.hidden = !show;
					if (show) visible += 1;
				});
				if (empty) empty.hidden = visible > 0;
				if (status) status.textContent = `${visible} ${visible === 1 ? 'story' : 'stories'} shown.`;
			}));
		}
		document.addEventListener('astro:page-load', wireCategoryChips);
		wireCategoryChips();
	</script>

	<!-- NEWSLETTER BAND -->
	<section class="tint" style="padding-block:clamp(72px,9vw,128px)">
		<div class="wrap"><div class="grid">
			<div class="reveal" style="grid-column:4 / 10; text-align:center">
				<h2 class="h2" style="margin-bottom:16px">Sundays, considered.</h2>
				<p class="dek" style="margin-bottom:40px">Get the best of {label} — and the rest of the week's edit — every Sunday.</p>
				<NewsletterSignup source={`category-${category}`}>
					<p slot="note" class="field-note" style="text-align:center;margin-top:20px">No noise. Unsubscribe anytime.</p>
				</NewsletterSignup>
			</div>
		</div></div>
	</section>
</BaseLayout>
