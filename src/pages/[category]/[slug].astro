---
import { getCollection, getEntry, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getCards, estimateReadingMinutes, isPreviewBuild } from '../../lib/articles';

export async function getStaticPaths() {
	// noindex posts still get a page (their own meta handles robots); future-dated
	// posts don't exist until the first build on/after their date. Drafts get a
	// page only on Vercel preview deploys (isPreviewBuild) so editors can share
	// a link — they stay out of production, listings, sitemaps and RSS.
	const now = new Date();
	const posts = await getCollection(
		'posts',
		({ data }) => (isPreviewBuild || !data.draft) && data.date <= now,
	);
	return posts.map((post) => ({
		// id is e.g. "2026/quiet-renaissance-…"; slug is the final segment.
		params: { category: post.data.category, slug: post.id.split('/').pop() },
		props: { post },
	}));
}

const { post } = Astro.props;
const author = await getEntry('authors', post.data.author);
if (!author) {
	throw new Error(`Unknown author "${post.data.author}" in ${post.id}`);
}
const { Content } = await render(post);
const d = post.data;

// Reading time: honour an explicit frontmatter value, else estimate from the body.
const readingMinutes = d.readingMinutes ?? estimateReadingMinutes(post.body);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length || undefined;

// Recirculation, drawn from the shared card index.
const cards = await getCards();
const currentUrl = `/${d.category}/${post.id.split('/').pop()}/`;
const others = cards.filter((c) => c.url !== currentUrl);
const sameCat = others.filter((c) => c.category === d.category);

const related = sameCat.slice(0, 3).map((c) => ({
	title: c.title,
	href: c.url,
	byline: c.byline,
	image: c.image,
	tone: c.tone,
}));

// Read-next: prefer a piece from another category, else the next in-category.
const rn = others.find((c) => c.category !== d.category) ?? sameCat[0] ?? others[0];
const readNext = rn
	? {
			title: rn.title,
			href: rn.url,
			categoryLabel: rn.categoryLabel,
			byline: rn.byline,
			image: rn.image,
			tone: rn.tone,
		}
	: undefined;

const moreGuides = others
	.filter((c) => c.category === 'guides')
	.slice(0, 3)
	.map((c) => ({ title: c.title, href: c.url, byline: c.byline, image: c.image, tone: c.tone }));

const authorHref = `/authors/${post.data.author}/`;

// Editorial reviewer (E-E-A-T) — resolved to the author entity when set.
const reviewer = d.reviewedBy ? await getEntry('authors', d.reviewedBy) : undefined;
const reviewedBy = reviewer ? { name: reviewer.data.name, href: `/authors/${reviewer.id}/` } : undefined;
const Layout = d.category === 'guides' ? GuideLayout : ArticleLayout;
const layoutExtra =
	d.category === 'guides' ? { moreGuides } : { related, readNext };
const clusterItems = d.cluster ? others.filter((card) => card.cluster === d.cluster).map((card) => ({ title: card.title, href: card.url })) : [];
---

<Layout
	title={d.title}
	standfirst={d.standfirst}
	category={d.category}
	tags={d.tags}
	date={d.date}
	readingMinutes={readingMinutes}
	wordCount={wordCount}
	heroImage={d.heroImage}
	heroCaption={d.heroCaption}
	heroCredit={d.heroCredit}
	author={author.data}
	authorHref={authorHref}
	seoTitle={d.seoTitle}
	metaDescription={d.metaDescription}
	updatedDate={d.updatedDate}
	noindex={d.noindex}
	faq={d.faq}
	howToName={d.howToName}
	howTo={d.howTo}
	listName={d.listName}
	listItems={d.listItems}
	kicker={d.kicker}
	articleType={d.articleType}
	timeliness={d.timeliness}
	franchise={d.franchise}
	cluster={d.cluster}
	clusterItems={clusterItems}
	atAGlance={d.atAGlance}
	halalStatus={d.halalStatus}
	lastVerified={d.lastVerified}
	reviewedBy={reviewedBy}
	method={d.method}
	sources={d.sources}
	correctionNote={d.correctionNote}
	commercial={d.commercial}
	isDraftPreview={d.draft === true}
	{...layoutExtra}
>
	<Content />
</Layout>
