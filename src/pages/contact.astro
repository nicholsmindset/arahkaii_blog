---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {
	SITE,
	organizationSchema,
	websiteSchema,
	webPageSchema,
	breadcrumbSchema,
} from '../lib/seo';

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const sent = Astro.url.searchParams.get('sent') === '1';
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	webPageSchema({
		name: 'Contact — Arahkaii',
		url: canonical,
		description: 'How to reach the Arahkaii desk — pitches, partnerships, press.',
		type: 'ContactPage',
	}),
	breadcrumbSchema([
		{ name: SITE.name, url: SITE.url },
		{ name: 'Contact', url: canonical },
	]),
];
---

<BaseLayout
	title="Contact — Arahkaii"
	description="Pitches, partnerships, or a quiet word — how to reach the Arahkaii desk."
	jsonLd={jsonLd}
>
	<div class="wrap">
		<div class="mw-640">
			<header class="cb-head">
				<Breadcrumbs schema={false} class="page-crumbs" items={[{ name: 'Arahkaii', href: '/' }, { name: 'Contact' }]} />
				<span class="eyebrow">Say hello</span>
				<h1 class="cb-title">Contact</h1>
				<p class="cb-dek">
					Pitches, partnerships, corrections or a quiet word — the desk reads everything, and
					replies to what it can.
				</p>
			</header>

			<form
				class="contact-form"
				name="contact"
				method="POST"
				action="/api/contact"
			>
				{sent && <p class="form-success" role="status">Thank you. Your note has reached the Arahkaii desk.</p>}
				<p hidden>
					<label>Leave this empty: <input name="bot-field" /></label>
				</p>

				<div class="cf-row">
					<label for="cf-name">Your name</label>
					<input id="cf-name" name="name" type="text" maxlength="120" required placeholder="First and last" />
				</div>
				<div class="cf-row">
					<label for="cf-email">Email</label>
					<input id="cf-email" name="email" type="email" maxlength="254" required placeholder="your@email.com" />
				</div>
				<div class="cf-row">
					<label for="cf-subject">Subject</label>
					<input id="cf-subject" name="subject" type="text" maxlength="160" placeholder="Pitch · partnership · note" />
				</div>
				<div class="cf-row">
					<label for="cf-message">Message</label>
					<textarea id="cf-message" name="message" minlength="10" maxlength="8000" required placeholder="Tell us, unhurried."></textarea>
				</div>
				<button class="cf-submit" type="submit">Send <span aria-hidden="true">→</span></button>
			</form>

			<p class="contact-alt">
				Prefer email? Write to <a href="mailto:hello@arahkaii.com">hello@arahkaii.com</a> — pitches,
				press and partnerships all reach the desk there.
			</p>
		</div>
	</div>
</BaseLayout>
