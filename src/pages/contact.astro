---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {
	SITE,
	organizationSchema,
	websiteSchema,
	webPageSchema,
	breadcrumbSchema,
} from '../lib/seo';

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const contactEnabled = Boolean(import.meta.env.RESEND_API_KEY?.trim());
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	webPageSchema({
		name: 'Contact — Arahkaii',
		url: canonical,
		description: 'How to reach the Arahkaii desk — pitches, partnerships, press.',
		type: 'ContactPage',
	}),
	breadcrumbSchema([
		{ name: SITE.name, url: SITE.url },
		{ name: 'Contact', url: canonical },
	]),
];
---

<BaseLayout
	title="Contact — Arahkaii"
	description="Pitches, partnerships, or a quiet word — how to reach the Arahkaii desk."
	jsonLd={jsonLd}
>
	<div class="wrap">
		<div class="mw-640">
			<header class="cb-head">
				<Breadcrumbs schema={false} class="page-crumbs" items={[{ name: 'Arahkaii', href: '/' }, { name: 'Contact' }]} />
				<span class="eyebrow">Say hello</span>
				<h1 class="cb-title">Contact</h1>
				<p class="cb-dek">
					Pitches, partnerships, corrections or a quiet word — the desk reads everything, and
					replies to what it can.
				</p>
			</header>
			<p class="contact-partner-route">A brand story, interview or campaign in mind? <a class="tlink" href="/partnerships/" data-partnership-cta>Visit the partner desk →</a></p>

			{contactEnabled ? (<form
				class="contact-form"
				name="contact"
				method="POST"
				action="/api/contact"
			>
				<p class="form-success" role="status" data-contact-success hidden>Thank you. Your note has reached the Arahkaii desk.</p>
				<p hidden>
					<label>Leave this empty: <input name="bot-field" /></label>
				</p>

				<div class="cf-row">
					<label for="cf-name">Your name</label>
					<input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="First and last" />
				</div>
				<div class="cf-row">
					<label for="cf-email">Email</label>
					<input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="your@email.com" />
				</div>
				<div class="cf-row">
					<label for="cf-subject">Subject</label>
					<input id="cf-subject" name="subject" type="text" maxlength="160" placeholder="Pitch · partnership · note" />
				</div>
				<div class="cf-row">
					<label for="cf-message">Message</label>
					<textarea id="cf-message" name="message" required minlength="10" maxlength="8000" placeholder="Tell us, unhurried."></textarea>
				</div>
				<button class="cf-submit" type="submit">Send <span aria-hidden="true">→</span></button>
			</form>) : (
				<div class="contact-email">
					<p>For pitches, partnerships and corrections, write directly to the desk.</p>
					<p><a class="tlink" data-contact-email href="mailto:onnifyworks@gmail.com">Email onnifyworks@gmail.com →</a></p>
					<p class="field-note">For a partnership, include your brand, website, preferred format, timing and indicative budget.</p>
				</div>
			)}

			{contactEnabled && <p class="contact-alt">
				Prefer email? Write to <a href="mailto:onnifyworks@gmail.com">onnifyworks@gmail.com</a> — pitches,
				press and partnerships all reach the desk there.
			</p>}
		</div>
	</div>
	<script>
		function preparePartnershipEnquiry() {
			const params = new URLSearchParams(location.search);
			const success = document.querySelector<HTMLElement>('[data-contact-success]');
			if (success) success.hidden = params.get('sent') !== '1';
			if (params.get('enquiry') !== 'partnership') return;
			const emailLink = document.querySelector<HTMLAnchorElement>('[data-contact-email]');
			if (emailLink) emailLink.href = 'mailto:onnifyworks@gmail.com?subject=Partnership%20enquiry';
			const subject = document.querySelector<HTMLInputElement>('#cf-subject');
			const message = document.querySelector<HTMLTextAreaElement>('#cf-message');
			if (subject && !subject.value) subject.value = 'Partnership enquiry';
			if (message) message.placeholder = 'Your brand and website, intended reader, preferred format, timing and indicative budget.';
		}
		document.addEventListener('astro:page-load', preparePartnershipEnquiry);
		preparePartnershipEnquiry();
	</script>
	<style>
		.contact-partner-route { margin-bottom: 28px; }
		.contact-email { padding-block: 24px; border-block: 1px solid var(--hairline); }
		.contact-email p { margin: 0 0 18px; }
		.contact-email .field-note { margin-bottom: 0; }
	</style>
</BaseLayout>
