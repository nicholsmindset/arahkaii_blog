---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

// Saved stories live in localStorage, so the grid is rendered on the client
// from window.ARAHKAII.getSaved(). Server renders only the shell.
---

<BaseLayout title="Your reading list — Arahkaii" noindex={true}>
	<div class="wrap">
		<header class="rl-head">
			<Breadcrumbs schema={false} class="page-crumbs" items={[{ name: 'Arahkaii', href: '/' }, { name: 'Reading list' }]} />
			<h1 class="rl-title">Reading list</h1>
			<p class="rl-dek">Saved for a slower moment.</p>
			<p class="rl-count" id="rl-count"></p>
		</header>
		<div id="rl-container"></div>
	</div>

	<script>
		function initReadingList() {
			const A = (window as any).ARAHKAII;
			const c = document.getElementById('rl-container');
			const count = document.getElementById('rl-count');
			if (!A || !c || !count) return;
			// Narrowed locals the nested render() closure can see as non-null.
			const container = c;
			const countEl = count;

			function render() {
				const items = A.getSaved() as Array<{ title: string; href: string; byline?: string }>;
				countEl.textContent = items.length
					? items.length + (items.length === 1 ? ' story' : ' stories') + ' saved'
					: '';
				if (!items.length) {
					container.innerHTML = `<div class="rl-empty">
						<svg class="e-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 3h12v18l-6-4-6 4V3Z"/></svg>
						<p>Nothing saved yet.</p>
						<p class="sub">Tap the bookmark on any story and it will wait for you here — across visits, on this device.</p>
						<a class="link-more" href="/latest/">Browse the latest</a>
					</div>`;
					return;
				}
				const grid = document.createElement('div');
				grid.className = 'rl-grid';
				items.forEach((it) => {
					const card = document.createElement('div');
					card.className = 'rl-card';
					const story = document.createElement('a');
					story.className = 'story';
					story.href = it.href;
					const image = document.createElement('div');
					image.className = 'img ph tone-b r-3x2';
					const heading = document.createElement('h2');
					heading.className = 'headline';
					heading.textContent = it.title;
					const byline = document.createElement('p');
					byline.className = 'byline';
					byline.textContent = it.byline || '';
					story.append(image, heading, byline);

					const remove = document.createElement('button');
					remove.className = 'rl-remove';
					remove.type = 'button';
					remove.setAttribute('aria-label', `Remove ${it.title} from reading list`);
					remove.textContent = '×';
					remove.addEventListener('click', (e) => {
						e.preventDefault();
						e.stopPropagation();
						A.toggleSave(it);
						render();
					});
					card.append(story, remove);
					grid.appendChild(card);
				});
				container.innerHTML = '';
				container.appendChild(grid);
			}
			render();
		}
		document.addEventListener('astro:page-load', initReadingList);
		initReadingList();
	</script>
</BaseLayout>
