---
import { Image, getImage } from 'astro:assets';
import StoryCard from '../components/StoryCard.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import {
	SITE,
	articleSchema,
	breadcrumbSchema,
	organizationSchema,
	websiteSchema,
	faqSchema,
	howToSchema,
	itemListSchema,
	type FaqItem,
	type HowToStep,
} from '../lib/seo';
import BaseLayout from './BaseLayout.astro';
import { fmtDate } from '../lib/format';
import '../styles/article.css';

interface AuthorData {
	name: string;
	role: string;
	bio: string;
	avatar?: ImageMetadata;
}
interface GuideItem {
	title: string;
	href: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface Props {
	title: string;
	standfirst: string;
	category: string;
	tags?: string[];
	date: Date;
	readingMinutes?: number;
	heroImage: ImageMetadata;
	heroCaption: string;
	heroCredit: string;
	author: AuthorData;
	authorHref?: string;
	moreGuides?: GuideItem[];
	seoTitle?: string;
	metaDescription?: string;
	updatedDate?: Date;
	noindex?: boolean;
	faq?: FaqItem[];
	howToName?: string;
	howTo?: HowToStep[];
	listName?: string;
	listItems?: string[];
}

const {
	title,
	standfirst,
	category,
	tags = [],
	date,
	readingMinutes,
	heroImage,
	heroCaption,
	heroCredit,
	author,
	authorHref = '/people',
	moreGuides = [],
	seoTitle,
	metaDescription,
	updatedDate,
	noindex = false,
	faq,
	howToName,
	howTo,
	listName,
	listItems,
} = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const categoryLabel = cap(category);
const primaryTag = tags[0];

// — SEO data layer (mirrors ArticleLayout) —
const canonical = new URL(Astro.url.pathname, Astro.site);
const seoDescription = metaDescription ?? standfirst;
const ogCrop = await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpg' });
const ogImage = new URL(ogCrop.src, Astro.site).toString();
const datePublished = date.toISOString();
const dateModified = (updatedDate ?? date).toISOString();
const authorUrl = new URL(authorHref, SITE.url).toString();
const crumbs = [
	{ name: SITE.name, url: SITE.url },
	{ name: categoryLabel, url: new URL(`/${category}`, SITE.url).toString() },
];
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	articleSchema({
		headline: title,
		description: seoDescription,
		image: ogImage,
		datePublished,
		dateModified,
		authorName: author.name,
		authorUrl,
		section: categoryLabel,
		url: canonical.toString(),
	}),
	breadcrumbSchema(crumbs),
];
// GEO / AIO schema — appended only when the frontmatter supplies the data.
if (faq?.length) jsonLd.push(faqSchema(faq));
if (howTo?.length) jsonLd.push(howToSchema(howToName ?? title, howTo));
if (listItems?.length)
	jsonLd.push(itemListSchema(listName ?? title, listItems, canonical.toString()));
const byline = `By ${author.name} · ${fmtDate(date)}${readingMinutes ? ` · ${readingMinutes} min read` : ''}`;
---

<BaseLayout
	title={seoTitle ?? `${title} — Arahkaii`}
	description={seoDescription}
	activeCategory={categoryLabel}
	image={ogImage}
	ogType="article"
	noindex={noindex}
	publishedTime={datePublished}
	modifiedTime={dateModified}
	authorName={author.name}
	section={categoryLabel}
	tags={tags}
	jsonLd={jsonLd}
>
	<article data-cat="guides">
		<header class="guide-head">
			<span class="eyebrow accent">{primaryTag ? `${categoryLabel} · ${cap(primaryTag)}` : categoryLabel}</span>
			<h1 class="guide-h1 art-h1">{title}</h1>
			<p class="guide-stand epigraph">{standfirst}</p>
			<p class="guide-byline meta">{byline}</p>
		</header>

		<figure class="guide-hero">
			<div class="img real r-16x9 blurup">
				<Image src={heroImage} alt={heroCaption || title} loading="eager" />
			</div>
			<figcaption class="caption">
				{heroCaption ? `Above: ${heroCaption} ` : ''}(Photo: {heroCredit})
			</figcaption>
		</figure>

		<div class="entries">
			<div class="article-body">
				<slot />
			</div>
		</div>

		<div class="guide-end">
			<div class="chapter ornament"><span>✦</span></div>
		</div>

		<InlineNewsletter
			class="end-news"
			source="guide-end"
			line="If this was your kind of quiet, join us on Sundays."
		/>
	</article>

	{
		moreGuides.length > 0 && (
			<section class="more-guides">
				<div class="rule" />
				<div style="display:flex; justify-content:space-between; align-items:baseline; margin-top:34px">
					<span class="eyebrow">More Guides</span>
					<a class="link-more" href="/guides">All Guides</a>
				</div>
				<div class="mg-grid">
					{moreGuides.slice(0, 3).map((g) => (
						<StoryCard
							href={g.href}
							title={g.title}
							byline={g.byline}
							image={g.image}
							tone={g.tone ?? 'tone-c'}
							ratio="3x2"
							category="guides"
						/>
					))}
				</div>
			</section>
		)
	}

	<!-- Sticky list index — fills itself from any .entry[id] blocks in the body
	     (structured listicle MDX); stays hidden for plain long-form guides. -->
	<nav class="guide-index" aria-label="Jump to entry"></nav>

	<script>
		function initGuideIndex() {
			const nav = document.querySelector<HTMLElement>('.guide-index');
			if (!nav) return;
			const entries = Array.from(document.querySelectorAll<HTMLElement>('.entry[id]'));
			if (!entries.length) {
				nav.style.display = 'none';
				return;
			}
			nav.style.removeProperty('display');
			nav.innerHTML =
				'<p class="gi-label">The list</p>' +
				entries
					.map((s) => {
						const n = s.querySelector('.num')?.textContent?.trim() || '';
						const name = s.querySelector('.entry-name')?.textContent?.trim() || '';
						return `<a href="#${s.id}" data-i="${s.id}"><span class="gi-n">${n}</span><span class="gi-t">${name}</span></a>`;
					})
					.join('');
			const links = new Map(
				Array.from(nav.querySelectorAll<HTMLElement>('a')).map((a) => [a.dataset.i, a]),
			);
			const io = new IntersectionObserver(
				(es) => {
					es.forEach((e) => {
						if (e.isIntersecting) {
							links.forEach((a) => a.classList.remove('active'));
							links.get((e.target as HTMLElement).id)?.classList.add('active');
						}
					});
				},
				{ rootMargin: '-45% 0px -45% 0px' },
			);
			entries.forEach((s) => io.observe(s));
		}
		document.addEventListener('astro:page-load', initGuideIndex);
	</script>
</BaseLayout>
