---
import { Image, getImage } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import StoryTools from '../components/article/StoryTools.astro';
import StoryCard from '../components/StoryCard.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import AtAGlance, { type AtAGlanceItem } from '../components/article/AtAGlance.astro';
import HalalStatus, { type HalalStatusData } from '../components/article/HalalStatus.astro';
import ClusterNav from '../components/article/ClusterNav.astro';
import ArticleFaq from '../components/article/ArticleFaq.astro';
import SourcesAndMethod, { type EditorialSource } from '../components/article/SourcesAndMethod.astro';
import CommercialDisclosure, { type CommercialDisclosureData } from '../components/article/CommercialDisclosure.astro';
import {
	SITE,
	articleSchema,
	breadcrumbSchema,
	organizationSchema,
	websiteSchema,
	faqSchema,
	howToSchema,
	itemListSchema,
	type FaqItem,
	type HowToStep,
} from '../lib/seo';
import BaseLayout from './BaseLayout.astro';
import { fmtDate } from '../lib/format';
import '../styles/article.css';

interface AuthorData {
	name: string;
	role: string;
	bio: string;
	avatar?: ImageMetadata;
}
interface GuideItem {
	title: string;
	href: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface Props {
	headings?: MarkdownHeading[];
	title: string;
	standfirst: string;
	category: string;
	tags?: string[];
	date: Date;
	readingMinutes?: number;
	wordCount?: number;
	heroImage: ImageMetadata;
	heroCaption: string;
	heroCredit: string;
	author: AuthorData;
	authorHref?: string;
	moreGuides?: GuideItem[];
	seoTitle?: string;
	metaDescription?: string;
	updatedDate?: Date;
	noindex?: boolean;
	faq?: FaqItem[];
	howToName?: string;
	howTo?: HowToStep[];
	listName?: string;
	listItems?: string[];
	kicker?: string;
	articleType?: string;
	timeliness?: 'evergreen' | 'timely';
	franchise?: string;
	cluster?: string;
	clusterItems?: Array<{ title: string; href: string }>;
	atAGlance?: AtAGlanceItem[];
	halalStatus?: HalalStatusData;
	lastVerified?: Date;
	/** Editorial reviewer — rendered in the byline and Article schema. */
	reviewedBy?: { name: string; href: string };
	method?: string;
	sources?: EditorialSource[];
	correctionNote?: string;
	commercial?: CommercialDisclosureData;
	/** True when this is an unpublished draft rendered on a preview deploy. */
	isDraftPreview?: boolean;
}

const {
	headings = [],
	title,
	standfirst,
	category,
	tags = [],
	date,
	readingMinutes,
	wordCount,
	heroImage,
	heroCaption,
	heroCredit,
	author,
	authorHref = '/people',
	moreGuides = [],
	seoTitle,
	metaDescription,
	updatedDate,
	noindex = false,
	faq,
	howToName,
	howTo,
	listName,
	listItems,
	kicker,
	timeliness = 'evergreen',
	franchise,
	cluster,
	clusterItems = [],
	atAGlance = [],
	halalStatus,
	lastVerified,
	reviewedBy,
	method,
	sources = [],
	correctionNote,
	commercial,
	isDraftPreview = false,
} = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const categoryLabel = cap(category);
const primaryTag = tags[0];

// — SEO data layer (mirrors ArticleLayout) —
const canonical = new URL(Astro.url.pathname, Astro.site);
const seoDescription = metaDescription ?? standfirst;
const ogCrop = await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpg' });
const ogImage = new URL(ogCrop.src, Astro.site).toString();
const datePublished = date.toISOString();
const dateModified = (updatedDate ?? date).toISOString();
const authorUrl = new URL(authorHref, SITE.url).toString();
const crumbs = [
	{ name: SITE.name, url: SITE.url },
	{ name: categoryLabel, url: new URL(`/${category}`, SITE.url).toString() },
];
const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	articleSchema({
		headline: title,
		description: seoDescription,
		image: ogImage,
		wordCount,
		datePublished,
		dateModified,
		authorName: author.name,
		authorUrl,
		section: categoryLabel,
		url: canonical.toString(),
		keywords: tags,
		type: timeliness === 'timely' ? 'NewsArticle' : 'Article',
		reviewedBy: reviewedBy ? { name: reviewedBy.name, url: new URL(reviewedBy.href, SITE.url).toString() } : undefined,
		sponsorName: commercial?.type === 'sponsored' ? commercial.partner : undefined,
	}),
	breadcrumbSchema(crumbs),
];
// GEO / AIO schema — appended only when the frontmatter supplies the data.
if (faq?.length) jsonLd.push(faqSchema(faq));
if (howTo?.length) jsonLd.push(howToSchema(howToName ?? title, howTo));
if (atAGlance.length)
	jsonLd.push(itemListSchema(listName ?? title, atAGlance.map((item) => ({ name: item.name, description: item.verdict, url: item.url })), canonical.toString()));
else if (listItems?.length) jsonLd.push(itemListSchema(listName ?? title, listItems, canonical.toString()));
const byline = `By ${author.name}${reviewedBy ? ` · Reviewed by ${reviewedBy.name}` : ''} · ${fmtDate(date)}${readingMinutes ? ` · ${readingMinutes} min read` : ''}`;
---

<BaseLayout
	title={seoTitle ?? `${title} — Arahkaii`}
	description={seoDescription}
	activeCategory={categoryLabel}
	image={ogImage}
	ogType="article"
	hideFooterNewsletter
	noindex={noindex || isDraftPreview}
	publishedTime={datePublished}
	modifiedTime={dateModified}
	authorName={author.name}
	section={categoryLabel}
	tags={tags}
	jsonLd={jsonLd}
>
	<article data-cat="guides" data-article-body>
		{isDraftPreview && (
			<p class="draft-banner" role="status">Draft preview — not yet published. This page is hidden from search and the rest of the site.</p>
		)}
		<header class="guide-head">
			<nav class="art-breadcrumb eyebrow eyebrow--emerald" aria-label="Breadcrumb">
				<a href={`/${category}/`}>{categoryLabel}</a>
				{(kicker ?? primaryTag) && <><span aria-hidden="true">·</span><span>{kicker ?? cap(primaryTag!)}</span></>}
			</nav>
			<h1 class="guide-h1 art-h1">{title}</h1>
			<p class="guide-stand epigraph">{standfirst}</p>
			<p class="guide-byline meta">{byline}</p>
			{correctionNote && <p class="correction-note"><strong>Correction:</strong> {correctionNote}</p>}
			<CommercialDisclosure data={commercial} />
		</header>

		<div class="wrap"><StoryTools title={title} byline={`By ${author.name}`} headings={headings} /></div>

		<figure class="guide-hero">
			<div class="img real r-16x9 blurup">
				<Image src={heroImage} alt={heroCaption || title} loading="eager" fetchpriority="high" widths={[768, 1280, 1920]} sizes="(max-width:1440px) 100vw, 1280px" />
			</div>
			<figcaption class="caption">
				{heroCaption ? `Above: ${heroCaption} ` : ''}(Credit: {heroCredit})
			</figcaption>
		</figure>

		<div class="entries">
			<div class="article-body" id="story" tabindex="-1">
				{atAGlance.length > 0 && <AtAGlance items={atAGlance} title={listName ?? 'At a glance'} />}
				{atAGlance.length === 0 && listItems?.length && <AtAGlance items={listItems.map((name) => ({ name, verdict: '' }))} title={listName ?? 'At a glance'} />}
				{halalStatus && <HalalStatus data={halalStatus} />}
				{(franchise || cluster || lastVerified) && <p class="article-proof meta">{franchise && `Series · ${franchise}`}{franchise && cluster && ' · '}{cluster && `Topic · ${cluster.replaceAll('-', ' ')}`}{(franchise || cluster) && lastVerified && ' · '}{lastVerified && `Editorially checked ${new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(lastVerified)}`}</p>}
				<slot />
				<SourcesAndMethod sources={sources} method={method} />
				{faq?.length && <ArticleFaq items={faq} />}
				{cluster && <ClusterNav cluster={cluster} items={clusterItems} />}
			</div>
		</div>

		<div class="guide-end">
			<div class="chapter ornament"><span>✦</span></div>
		</div>

		<InlineNewsletter
			class="end-news"
			source="guide-end"
			line="If this was your kind of quiet, join us on Sundays."
		/>
	</article>

	{
		moreGuides.length > 0 && (
			<section class="more-guides">
				<div class="rule" />
				<div style="display:flex; justify-content:space-between; align-items:baseline; margin-top:34px">
					<span class="eyebrow">More Guides</span>
					<a class="link-more" href="/guides/">All Guides</a>
				</div>
				<div class="mg-grid">
					{moreGuides.slice(0, 3).map((g) => (
						<StoryCard
							href={g.href}
							title={g.title}
							byline={g.byline}
							image={g.image}
							tone={g.tone ?? 'tone-c'}
							ratio="3x2"
							category="guides"
						/>
					))}
				</div>
			</section>
		)
	}

	<!-- Sticky list index — fills itself from any .entry[id] blocks in the body
	     (structured listicle MDX); stays hidden for plain long-form guides. -->
	<nav class="guide-index" aria-label="Jump to entry"></nav>

	<script>
		let guideObserver: IntersectionObserver | undefined;
		function initGuideIndex() {
			guideObserver?.disconnect();
			const nav = document.querySelector<HTMLElement>('.guide-index');
			if (!nav) return;
			const entries = Array.from(document.querySelectorAll<HTMLElement>('.entry[id]'));
			if (!entries.length) {
				nav.style.display = 'none';
				return;
			}
			nav.style.removeProperty('display');
			const label = document.createElement('p');
			label.className = 'gi-label';
			label.textContent = 'The list';
			const entryLinks = entries.map((entry) => {
				const link = document.createElement('a');
				link.href = `#${encodeURIComponent(entry.id)}`;
				link.dataset.i = entry.id;

				const number = document.createElement('span');
				number.className = 'gi-n';
				number.textContent = entry.querySelector('.num')?.textContent?.trim() || '';

				const title = document.createElement('span');
				title.className = 'gi-t';
				title.textContent = entry.querySelector('.entry-name')?.textContent?.trim() || '';
				link.append(number, title);
				return link;
			});
			nav.replaceChildren(label, ...entryLinks);
			const links = new Map(
				Array.from(nav.querySelectorAll<HTMLElement>('a')).map((a) => [a.dataset.i, a]),
			);
			guideObserver = new IntersectionObserver(
				(es) => {
					es.forEach((e) => {
						if (e.isIntersecting) {
							links.forEach((a) => a.classList.remove('active'));
							links.get((e.target as HTMLElement).id)?.classList.add('active');
						}
					});
				},
				{ rootMargin: '-45% 0px -45% 0px' },
			);
			entries.forEach((s) => guideObserver?.observe(s));
		}
		document.addEventListener('astro:page-load', initGuideIndex);
		document.addEventListener('astro:before-swap', () => guideObserver?.disconnect());
	</script>
</BaseLayout>
