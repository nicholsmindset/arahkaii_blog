---
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Headline from '../components/article/Headline.astro';
import Standfirst from '../components/article/Standfirst.astro';
import StoryCard from '../components/StoryCard.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import AtAGlance, { type AtAGlanceItem } from '../components/article/AtAGlance.astro';
import HalalStatus, { type HalalStatusData } from '../components/article/HalalStatus.astro';
import ClusterNav from '../components/article/ClusterNav.astro';
import ArticleFaq from '../components/article/ArticleFaq.astro';
import SourcesAndMethod, { type EditorialSource } from '../components/article/SourcesAndMethod.astro';
import CommercialDisclosure, { type CommercialDisclosureData } from '../components/article/CommercialDisclosure.astro';
import {
	SITE,
	articleSchema,
	breadcrumbSchema,
	organizationSchema,
	websiteSchema,
	faqSchema,
	howToSchema,
	itemListSchema,
	type FaqItem,
	type HowToStep,
} from '../lib/seo';
import { getTagIndex } from '../lib/articles';
import '../styles/article.css';

interface AuthorData {
	name: string;
	role: string;
	bio: string;
	avatar?: ImageMetadata;
}
interface RelatedItem {
	title: string;
	href: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface ReadNextItem {
	title: string;
	href: string;
	categoryLabel: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface Props {
	title: string;
	standfirst: string;
	category: string;
	tags?: string[];
	date: Date;
	readingMinutes?: number;
	wordCount?: number;
	heroImage: ImageMetadata;
	heroCaption: string;
	heroCredit: string;
	author: AuthorData;
	authorHref?: string;
	related?: RelatedItem[];
	readNext?: ReadNextItem;
	// SEO overrides (optional, threaded from frontmatter).
	seoTitle?: string;
	metaDescription?: string;
	updatedDate?: Date;
	noindex?: boolean;
	// GEO / AIO structured data (optional, threaded from frontmatter).
	faq?: FaqItem[];
	howToName?: string;
	howTo?: HowToStep[];
	listName?: string;
	listItems?: string[];
	kicker?: string;
	articleType?: string;
	timeliness?: 'evergreen' | 'timely';
	franchise?: string;
	cluster?: string;
	clusterItems?: Array<{ title: string; href: string }>;
	atAGlance?: AtAGlanceItem[];
	halalStatus?: HalalStatusData;
	lastVerified?: Date;
	/** Editorial reviewer — rendered in the byline row and Article schema. */
	reviewedBy?: { name: string; href: string };
	method?: string;
	sources?: EditorialSource[];
	correctionNote?: string;
	commercial?: CommercialDisclosureData;
	/** True when this is an unpublished draft rendered on a preview deploy. */
	isDraftPreview?: boolean;
}

const {
	title,
	standfirst,
	category,
	tags = [],
	date,
	readingMinutes,
	wordCount,
	heroImage,
	heroCaption,
	heroCredit,
	author,
	authorHref = '/people/',
	related = [],
	readNext,
	seoTitle,
	metaDescription,
	updatedDate,
	noindex = false,
	faq,
	howToName,
	howTo,
	listName,
	listItems,
	kicker,
	timeliness = 'evergreen',
	franchise,
	cluster,
	clusterItems = [],
	atAGlance = [],
	halalStatus,
	lastVerified,
	reviewedBy,
	method,
	sources = [],
	correctionNote,
	commercial,
	isDraftPreview = false,
} = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const categoryLabel = cap(category);
const primaryTag = tags[0];
// A tag links to its archive only when that archive exists (meets MIN_TAG_POSTS);
// otherwise the chip falls back to the category page.
const tagIndex = await getTagIndex();
const tagHref = (t: string) => (tagIndex.has(t) ? `/tags/${t}/` : `/${category}/`);
const formattedDate = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(date);
const formattedUpdatedDate = updatedDate
	? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(updatedDate)
	: null;

// — SEO data layer —
const canonical = new URL(Astro.url.pathname, Astro.site);
const seoDescription = metaDescription ?? standfirst;

// 1200×630 social crop from the hero, as an absolute URL.
const ogCrop = await getImage({
	src: heroImage,
	width: 1200,
	height: 630,
	format: 'jpg',
});
const ogImage = new URL(ogCrop.src, Astro.site).toString();

const datePublished = date.toISOString();
const dateModified = (updatedDate ?? date).toISOString();
const authorUrl = new URL(authorHref, SITE.url).toString();

const crumbs = [
	{ name: SITE.name, url: SITE.url },
	{ name: categoryLabel, url: new URL(`/${category}/`, SITE.url).toString() },
];
if (primaryTag) crumbs.push({ name: primaryTag, url: canonical.toString() });

const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	articleSchema({
		headline: title,
		description: seoDescription,
		image: ogImage,
		wordCount,
		datePublished,
		dateModified,
		authorName: author.name,
		authorUrl,
		section: categoryLabel,
		url: canonical.toString(),
		keywords: tags,
		type: timeliness === 'timely' ? 'NewsArticle' : 'Article',
		reviewedBy: reviewedBy ? { name: reviewedBy.name, url: new URL(reviewedBy.href, SITE.url).toString() } : undefined,
		sponsorName: commercial?.type === 'sponsored' ? commercial.partner : undefined,
	}),
	breadcrumbSchema(crumbs),
];
// GEO / AIO schema — appended only when the frontmatter supplies the data.
if (faq?.length) jsonLd.push(faqSchema(faq));
if (howTo?.length) jsonLd.push(howToSchema(howToName ?? title, howTo));
if (atAGlance.length)
	jsonLd.push(itemListSchema(listName ?? title, atAGlance.map((item) => ({ name: item.name, description: item.verdict, url: item.url })), canonical.toString()));
else if (listItems?.length) jsonLd.push(itemListSchema(listName ?? title, listItems, canonical.toString()));
---

<BaseLayout
	title={seoTitle ?? `${title} — Arahkaii`}
	description={seoDescription}
	activeCategory={categoryLabel}
	image={ogImage}
	ogType="article"
	noindex={noindex || isDraftPreview}
	publishedTime={datePublished}
	modifiedTime={dateModified}
	authorName={author.name}
	section={categoryLabel}
	tags={tags}
	jsonLd={jsonLd}
>
	<article data-cat={category} data-article-body>
		{isDraftPreview && (
			<p class="draft-banner" role="status">Draft preview — not yet published. This page is hidden from search and the rest of the site.</p>
		)}
		<!-- HERO: centred, no-image (T Magazine pattern) -->
		<div class="wrap art-hero">
			<nav class="art-breadcrumb eyebrow eyebrow--emerald" aria-label="Breadcrumb">
				<a href={`/${category}/`}>{categoryLabel}</a>
				{(kicker ?? primaryTag) && <><span aria-hidden="true">·</span><span>{kicker ?? primaryTag}</span></>}
			</nav>
			<Headline text={title} />
			<Standfirst text={standfirst} />
			<div class="art-byrow">
				<span class="meta"><strong>Words</strong> &nbsp;<a href={authorHref}>{author.name}</a></span>
				{
					reviewedBy && (
						<>
							<span class="dot" />
							<span class="meta"><strong>Reviewed</strong> &nbsp;<a href={reviewedBy.href}>{reviewedBy.name}</a></span>
						</>
					)
				}
				<span class="dot"></span>
				<time class="meta" datetime={datePublished}>{formattedDate}</time>
				{
					readingMinutes && (
						<>
							<span class="dot"></span>
							<span class="meta">Read · {readingMinutes} min</span>
						</>
					)
				}
				{formattedUpdatedDate && <><span class="dot"></span><time class="meta" datetime={dateModified}>Updated · {formattedUpdatedDate}</time></>}
			</div>
			{correctionNote && <p class="correction-note"><strong>Correction:</strong> {correctionNote}</p>}
			<CommercialDisclosure data={commercial} />
		</div>

		<!-- lead image, full content width 3:2 -->
		<div class="wrap" style="margin-top:48px">
			<figure class="hero-fig">
				<div class="media ar-3-2">
					<Image src={heroImage} alt={heroCaption || title} loading="eager" fetchpriority="high" widths={[768, 1280, 1920]} sizes="(max-width:1440px) 100vw, 1280px" />
				</div>
				<figcaption class="caption fig-cap">
					{heroCaption ? `${heroCaption} ` : ''}(Photo: {heroCredit})
				</figcaption>
			</figure>
		</div>

		<!-- body + sticky rail -->
		<div class="wrap" style="margin-top:64px">
			<div class="grid art-layout">
				<div class="article-body">
					{atAGlance.length > 0 && <AtAGlance items={atAGlance} title={listName ?? 'At a glance'} />}
					{atAGlance.length === 0 && listItems?.length && <AtAGlance items={listItems.map((name) => ({ name, verdict: '' }))} title={listName ?? 'At a glance'} />}
					{halalStatus && <HalalStatus data={halalStatus} />}
					{(franchise || cluster || lastVerified) && <p class="article-proof meta">{franchise && `Series · ${franchise}`}{franchise && cluster && ' · '}{cluster && `Topic · ${cluster.replaceAll('-', ' ')}`}{(franchise || cluster) && lastVerified && ' · '}{lastVerified && `Editorially checked ${new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(lastVerified)}`}</p>}
					<slot />
					<SourcesAndMethod sources={sources} method={method} />
					{faq?.length && <ArticleFaq items={faq} />}
					{cluster && <ClusterNav cluster={cluster} items={clusterItems} />}

					{
						tags.length > 0 && (
							<div class="article-tags">
								<span class="at-label">Filed under</span>
								{tags.map((t) => (
									<a class="chip" href={tagHref(t)}>{t}</a>
								))}
							</div>
						)
					}

					{/* Mid-article capture — relocated by script to sit after the 2nd H2. */}
					<InlineNewsletter
						class="js-mid-news mid-news"
						source="article-mid"
						line="Stories like this, gathered once a week — Sundays, in your inbox."
					/>

					<div class="sectionbreak"><span class="star">✦</span></div>

					<div class="author">
						<a href={authorHref} class="ab-avatar-link author__portrait" aria-label={`More by ${author.name}`}>
							{
								author.avatar ? (
									<Image src={author.avatar} alt={author.name} width={160} height={160} />
								) : (
									<div class="ph" data-label="Author" />
								)
							}
						</a>
						<div>
							<p class="ab-name"><a href={authorHref}>{author.name}</a></p>
							<p class="ab-role">{author.role}</p>
							<p>{author.bio}</p>
							<a class="tlink" href={authorHref}>Read more by {author.name} →</a>
						</div>
					</div>
				</div>

				<aside class="art-rail">
					<div class="art-rail__sticky">
						<div class="media ar-4-5 art-rail__thumb">
							<Image src={heroImage} alt={title} widths={[300, 500]} sizes="25vw" />
						</div>
						<div class="share" role="group" aria-label="Share">
							<button
								data-save-story
								data-title={title}
								data-href={Astro.url.pathname}
								data-byline={`By ${author.name}`}
								type="button"
								aria-label="Save to reading list">SAVE</button
							>
							<button data-share-copy type="button" aria-label="Copy link">LINK</button>
							<span class="sr-only" role="status" aria-live="polite" data-share-status></span>
							<a
								href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical.toString())}&text=${encodeURIComponent(title)}`}
								target="_blank"
								rel="noopener"
								aria-label="Share on X">X</a
							>
							<a
								href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical.toString())}`}
								target="_blank"
								rel="noopener"
								aria-label="Share on Facebook">FB</a
							>
						</div>
						{
							related.length > 0 && (
								<>
									<p class="rail-list__h">Continue reading</p>
									<nav class="rail-list" aria-label="Related">
										{related.slice(0, 3).map((r, i) => (
											<a class="hl-link" href={r.href} style={i === Math.min(related.length, 3) - 1 ? 'border-bottom:0' : undefined}>
												<span class="h5 hl" style="font-size:17px">{r.title}</span>
											</a>
										))}
									</nav>
								</>
							)
						}
					</div>
				</aside>
			</div>
		</div>
	</article>

	<!-- CONTINUE WITH (oversized next-article card) -->
	{
		readNext && (
			<section class="section article-read-next" style="border-top:1px solid var(--hairline)">
				<div class="wrap">
					<p class="eyebrow eyebrow--emerald" style="margin-bottom:32px">Read next →</p>
					<a class="hl-link readnext" href={readNext.href}>
						<div class="media ar-5-7" style="max-height:520px">
							{readNext.image ? (
								<Image src={readNext.image} alt={readNext.title} widths={[480, 800]} sizes="(max-width:900px) 100vw, 40vw" />
							) : (
								<div class="ph" data-label={`${readNext.categoryLabel} · 5:7`} />
							)}
						</div>
						<div>
							<p class="kicker11" style="margin-bottom:16px">{readNext.categoryLabel}</p>
							<h2 class="h3"><span class="hl">{readNext.title}</span></h2>
							<p class="dek" style="font-size:var(--body);font-style:normal;color:var(--ink-2);margin-top:16px;max-width:46ch">{readNext.byline}</p>
						</div>
					</a>
				</div>
			</section>
		)
	}

	<!-- ALSO FROM CATEGORY -->
	{
		related.length > 0 && (
			<section class="section--tight article-more">
				<div class="wrap">
					<p class="eyebrow" style="margin-bottom:24px">Also from {categoryLabel}</p>
					<hr class="rule" style="margin-bottom:40px" />
					<div class="more-grid">
						{related.slice(0, 3).map((r) => (
							<StoryCard
								href={r.href}
								title={r.title}
								image={r.image}
								ratio="3x2"
								heading="h5"
								category={category}
								label={`${categoryLabel} · 3:2`}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- NEWSLETTER BAND (identical to homepage) -->
	<section class="tint article-end-newsletter">
		<div class="wrap"><div class="grid">
			<div style="grid-column:4 / 10; text-align:center">
				<h2 class="h2" style="margin-bottom:16px">Sundays, considered.</h2>
				<p class="dek" style="margin-bottom:40px">Our weekly edit — one essay, three things to read, one place to go.</p>
				<NewsletterSignup source="article-end">
					<p slot="note" class="field-note" style="text-align:center;margin-top:20px">No noise. Unsubscribe anytime.</p>
				</NewsletterSignup>
			</div>
		</div></div>
	</section>

	<script>
		// Relocate the mid-article newsletter to sit after the 2nd H2 in the body
		// (a natural pause for an engaged reader). If the piece is short (<2 H2s),
		// drop it — the end-of-article unit already covers the high-intent moment.
		function placeMidNews() {
			const mid = document.querySelector<HTMLElement>('.js-mid-news');
			if (!mid || mid.dataset.placed) return;
			const body = document.querySelector('.article-body');
			const h2s = body ? Array.from(body.querySelectorAll(':scope > h2')) : [];
			if (h2s.length >= 2) {
				h2s[1].insertAdjacentElement('beforebegin', mid);
				mid.dataset.placed = '1';
			} else {
				mid.remove();
			}
		}
		function wireSaveStory() {
			const button = document.querySelector<HTMLButtonElement>('[data-save-story]');
			const api = (window as Window & {
				ARAHKAII?: {
					getSaved: () => Array<{ href: string }>;
					toggleSave: (item: { title: string; href: string; byline?: string }) => boolean;
				};
			}).ARAHKAII;
			if (!button || !api || button.dataset.wired) return;
			button.dataset.wired = '1';
			const story = {
				title: button.dataset.title || '',
				href: button.dataset.href || '',
				byline: button.dataset.byline,
			};
			const reflect = (saved: boolean) => {
				button.textContent = saved ? 'SAVED' : 'SAVE';
				button.setAttribute('aria-pressed', String(saved));
			};
			reflect(api.getSaved().some((item) => item.href === story.href));
			button.addEventListener('click', () => reflect(api.toggleSave(story)));
		}
		document.addEventListener('astro:page-load', placeMidNews);
		document.addEventListener('astro:page-load', wireSaveStory);
		wireSaveStory();
	</script>
</BaseLayout>
