---
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Headline from '../components/article/Headline.astro';
import Standfirst from '../components/article/Standfirst.astro';
import Byline from '../components/article/Byline.astro';
import StoryCard from '../components/StoryCard.astro';
import {
	SITE,
	articleSchema,
	breadcrumbSchema,
	organizationSchema,
	websiteSchema,
	faqSchema,
	howToSchema,
	itemListSchema,
	type FaqItem,
	type HowToStep,
} from '../lib/seo';
import '../styles/article.css';

interface AuthorData {
	name: string;
	role: string;
	bio: string;
	avatar?: ImageMetadata;
}
interface RelatedItem {
	title: string;
	href: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface ReadNextItem {
	title: string;
	href: string;
	categoryLabel: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface Props {
	title: string;
	standfirst: string;
	category: string;
	tags?: string[];
	date: Date;
	readingMinutes?: number;
	heroImage: ImageMetadata;
	heroCaption: string;
	heroCredit: string;
	author: AuthorData;
	authorHref?: string;
	related?: RelatedItem[];
	readNext?: ReadNextItem;
	// SEO overrides (optional, threaded from frontmatter).
	seoTitle?: string;
	metaDescription?: string;
	updatedDate?: Date;
	noindex?: boolean;
	// GEO / AIO structured data (optional, threaded from frontmatter).
	faq?: FaqItem[];
	howToName?: string;
	howTo?: HowToStep[];
	listName?: string;
	listItems?: string[];
}

const {
	title,
	standfirst,
	category,
	tags = [],
	date,
	readingMinutes,
	heroImage,
	heroCaption,
	heroCredit,
	author,
	authorHref = '/people',
	related = [],
	readNext,
	seoTitle,
	metaDescription,
	updatedDate,
	noindex = false,
	faq,
	howToName,
	howTo,
	listName,
	listItems,
} = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const categoryLabel = cap(category);
const primaryTag = tags[0];
const eyebrow = primaryTag ? `${categoryLabel} · ${primaryTag}` : categoryLabel;

// — SEO data layer —
const canonical = new URL(Astro.url.pathname, Astro.site);
const seoDescription = metaDescription ?? standfirst;

// 1200×630 social crop from the hero, as an absolute URL.
const ogCrop = await getImage({
	src: heroImage,
	width: 1200,
	height: 630,
	format: 'jpg',
});
const ogImage = new URL(ogCrop.src, Astro.site).toString();

const datePublished = date.toISOString();
const dateModified = (updatedDate ?? date).toISOString();
const authorUrl = new URL(authorHref, SITE.url).toString();

const crumbs = [
	{ name: SITE.name, url: SITE.url },
	{ name: categoryLabel, url: new URL(`/${category}`, SITE.url).toString() },
];
if (primaryTag) crumbs.push({ name: primaryTag, url: canonical.toString() });

const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	articleSchema({
		headline: title,
		description: seoDescription,
		image: ogImage,
		datePublished,
		dateModified,
		authorName: author.name,
		authorUrl,
		section: categoryLabel,
		url: canonical.toString(),
	}),
	breadcrumbSchema(crumbs),
];
// GEO / AIO schema — appended only when the frontmatter supplies the data.
if (faq?.length) jsonLd.push(faqSchema(faq));
if (howTo?.length) jsonLd.push(howToSchema(howToName ?? title, howTo));
if (listItems?.length)
	jsonLd.push(itemListSchema(listName ?? title, listItems, canonical.toString()));
---

<BaseLayout
	title={seoTitle ?? `${title} — Arahkaii`}
	description={seoDescription}
	activeCategory={categoryLabel}
	image={ogImage}
	ogType="article"
	noindex={noindex}
	publishedTime={datePublished}
	modifiedTime={dateModified}
	authorName={author.name}
	section={categoryLabel}
	tags={tags}
	jsonLd={jsonLd}
>
	<article data-cat={category}>
		<header class="article-head">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Arahkaii</a><span class="sep">/</span><a href={`/${category}`}
					>{categoryLabel}</a
				>{primaryTag && (<><span class="sep">/</span><span>{primaryTag}</span></>)}
			</nav>
			<span class="eyebrow accent" style="margin-top:18px">{eyebrow}</span>
			<Headline text={title} />
			<Standfirst text={standfirst} />
			<Byline author={author.name} date={date} readingMinutes={readingMinutes} />
		</header>

		<figure class="hero-fig">
			<div class="img real r-16x9 blurup">
				<Image src={heroImage} alt={heroCaption} loading="eager" />
			</div>
			<figcaption class="fig-cap caption">
				{heroCaption ? `Above: ${heroCaption} ` : ''}(Photo: {heroCredit})
			</figcaption>
		</figure>

		<div class="article-body">
			<slot />
		</div>

		<div class="chapter ornament end-orn"><span>✦</span></div>

		<div class="author-bio">
			{
				author.avatar ? (
					<div class="img real avatar">
						<Image src={author.avatar} alt={author.name} width={152} height={152} />
					</div>
				) : (
					<div class="img ph tone-b avatar" />
				)
			}
			<div>
				<p class="ab-name">{author.name}</p>
				<p class="ab-role">{author.role}</p>
				<p>{author.bio}</p>
				<a class="link-more" href={authorHref}>Read more by {author.name}</a>
			</div>
		</div>

		{
			readNext && (
				<section class="read-next">
					<div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:28px">
						<span class="eyebrow">Read next</span>
						<span class="meta">Chosen for you</span>
					</div>
					<a class="story rn-card" href={readNext.href} data-cat={readNext.categoryLabel.toLowerCase()}>
						{readNext.image ? (
							<div class="img real rn-img blurup">
								<Image src={readNext.image} alt={readNext.title} />
							</div>
						) : (
							<div class={`img ph ${readNext.tone ?? 'tone-d'} rn-img blurup`}>
								<span class="lab">{readNext.categoryLabel} · 16:9</span>
							</div>
						)}
						<div class="rn-body">
							<span class="eyebrow accent rn-eyebrow">{readNext.categoryLabel}</span>
							<h2 class="rn-title">{readNext.title}</h2>
							<p class="byline rn-meta">{readNext.byline}</p>
						</div>
					</a>
				</section>
			)
		}

		{
			related.length > 0 && (
				<section class="more-from">
					<div class="rule" />
					<div
						style="display:flex; justify-content:space-between; align-items:baseline; margin-top:34px"
					>
						<span class="eyebrow">More from {categoryLabel}</span>
						<a class="link-more" href={`/${category}`}>
							All {categoryLabel}
						</a>
					</div>
					<div class="more-grid">
						{related.slice(0, 3).map((r) => (
							<StoryCard
								href={r.href}
								title={r.title}
								byline={r.byline}
								image={r.image}
								tone={r.tone ?? 'tone-c'}
								ratio="3x2"
								category={category}
							/>
						))}
					</div>
				</section>
			)
		}
	</article>

	<aside class="share-rail">
		<p class="sr-label">Share</p>
		<button class="share-item" data-act="x" type="button"
			><svg viewBox="0 0 24 24" fill="currentColor"
				><path d="M17.5 3h3l-6.5 7.4L21.7 21h-5.9l-4.6-6-5.3 6H3l7-8L2.6 3h6l4.2 5.5L17.5 3Zm-1 16h1.6L8 4.8H6.3L16.5 19Z"
				></path></svg
			><span>Share on X</span></button
		>
		<button class="share-item" data-act="fb" type="button"
			><svg viewBox="0 0 24 24" fill="currentColor"
				><path d="M14 9h2.5l.5-3H14V4.3c0-.9.3-1.5 1.6-1.5H17V.1C16.7.1 15.7 0 14.6 0 12.2 0 10.6 1.4 10.6 4v2H8v3h2.6v9H14V9Z"
				></path></svg
			><span>Share on Facebook</span></button
		>
		<button class="share-item" data-act="copy" type="button"
			><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path
					d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg
			><span>Copy link</span></button
		>
		<button class="share-item" data-act="save" type="button"
			><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
				><path d="M6 3h12v18l-6-4-6 4V3Z"></path></svg
			><span>Save</span></button
		>
	</aside>
</BaseLayout>
