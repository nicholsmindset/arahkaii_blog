---
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Headline from '../components/article/Headline.astro';
import Standfirst from '../components/article/Standfirst.astro';
import StoryCard from '../components/StoryCard.astro';
import InlineNewsletter from '../components/InlineNewsletter.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import {
	SITE,
	articleSchema,
	breadcrumbSchema,
	organizationSchema,
	websiteSchema,
	faqSchema,
	howToSchema,
	itemListSchema,
	type FaqItem,
	type HowToStep,
} from '../lib/seo';
import '../styles/article.css';

interface AuthorData {
	name: string;
	role: string;
	bio: string;
	avatar?: ImageMetadata;
}
interface RelatedItem {
	title: string;
	href: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface ReadNextItem {
	title: string;
	href: string;
	categoryLabel: string;
	byline: string;
	tone?: string;
	image?: ImageMetadata;
}
interface Props {
	title: string;
	standfirst: string;
	category: string;
	tags?: string[];
	date: Date;
	readingMinutes?: number;
	heroImage: ImageMetadata;
	heroCaption: string;
	heroCredit: string;
	author: AuthorData;
	authorHref?: string;
	related?: RelatedItem[];
	readNext?: ReadNextItem;
	// SEO overrides (optional, threaded from frontmatter).
	seoTitle?: string;
	metaDescription?: string;
	updatedDate?: Date;
	noindex?: boolean;
	// GEO / AIO structured data (optional, threaded from frontmatter).
	faq?: FaqItem[];
	howToName?: string;
	howTo?: HowToStep[];
	listName?: string;
	listItems?: string[];
}

const {
	title,
	standfirst,
	category,
	tags = [],
	date,
	readingMinutes,
	heroImage,
	heroCaption,
	heroCredit,
	author,
	authorHref = '/people',
	related = [],
	readNext,
	seoTitle,
	metaDescription,
	updatedDate,
	noindex = false,
	faq,
	howToName,
	howTo,
	listName,
	listItems,
} = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const categoryLabel = cap(category);
const primaryTag = tags[0];
const formattedDate = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(date);
const formattedUpdatedDate = updatedDate
	? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(updatedDate)
	: null;

// — SEO data layer —
const canonical = new URL(Astro.url.pathname, Astro.site);
const seoDescription = metaDescription ?? standfirst;

// 1200×630 social crop from the hero, as an absolute URL.
const ogCrop = await getImage({
	src: heroImage,
	width: 1200,
	height: 630,
	format: 'jpg',
});
const ogImage = new URL(ogCrop.src, Astro.site).toString();

const datePublished = date.toISOString();
const dateModified = (updatedDate ?? date).toISOString();
const authorUrl = new URL(authorHref, SITE.url).toString();

const crumbs = [
	{ name: SITE.name, url: SITE.url },
	{ name: categoryLabel, url: new URL(`/${category}`, SITE.url).toString() },
];
if (primaryTag) crumbs.push({ name: primaryTag, url: canonical.toString() });

const jsonLd = [
	organizationSchema(),
	websiteSchema(),
	articleSchema({
		headline: title,
		description: seoDescription,
		image: ogImage,
		datePublished,
		dateModified,
		authorName: author.name,
		authorUrl,
		section: categoryLabel,
		url: canonical.toString(),
	}),
	breadcrumbSchema(crumbs),
];
// GEO / AIO schema — appended only when the frontmatter supplies the data.
if (faq?.length) jsonLd.push(faqSchema(faq));
if (howTo?.length) jsonLd.push(howToSchema(howToName ?? title, howTo));
if (listItems?.length)
	jsonLd.push(itemListSchema(listName ?? title, listItems, canonical.toString()));
---

<BaseLayout
	title={seoTitle ?? `${title} — Arahkaii`}
	description={seoDescription}
	activeCategory={categoryLabel}
	image={ogImage}
	ogType="article"
	noindex={noindex}
	publishedTime={datePublished}
	modifiedTime={dateModified}
	authorName={author.name}
	section={categoryLabel}
	tags={tags}
	jsonLd={jsonLd}
>
	<article data-cat={category} data-article-body>
		<!-- HERO: centred, no-image (T Magazine pattern) -->
		<div class="wrap art-hero">
			<nav class="art-breadcrumb eyebrow eyebrow--emerald" aria-label="Breadcrumb">
				<a href={`/${category}`}>{categoryLabel}</a>
				{primaryTag && <><span aria-hidden="true">·</span><span>{primaryTag}</span></>}
			</nav>
			<Headline text={title} />
			<Standfirst text={standfirst} />
			<div class="art-byrow">
				<span class="meta"><strong>Words</strong> &nbsp;<a href={authorHref}>{author.name}</a></span>
				<span class="dot"></span>
				<span class="meta">{formattedDate}</span>
				{
					readingMinutes && (
						<>
							<span class="dot"></span>
							<span class="meta">Read · {readingMinutes} min</span>
						</>
					)
				}
				{formattedUpdatedDate && <><span class="dot"></span><span class="meta">Updated · {formattedUpdatedDate}</span></>}
			</div>
		</div>

		<!-- lead image, full content width 3:2 -->
		<div class="wrap" style="margin-top:48px">
			<figure class="hero-fig">
				<div class="media ar-3-2">
					<Image src={heroImage} alt={heroCaption || title} loading="eager" widths={[768, 1280, 1920]} sizes="(max-width:1440px) 100vw, 1280px" />
				</div>
				<figcaption class="caption fig-cap">
					{heroCaption ? `${heroCaption} ` : ''}(Photo: {heroCredit})
				</figcaption>
			</figure>
		</div>

		<!-- body + sticky rail -->
		<div class="wrap" style="margin-top:64px">
			<div class="grid art-layout">
				<div class="article-body">
					<slot />

					{
						tags.length > 0 && (
							<div class="article-tags">
								<span class="at-label">Filed under</span>
								{tags.map((t) => (
									<a class="chip" href={`/${category}`}>{t}</a>
								))}
							</div>
						)
					}

					{/* Mid-article capture — relocated by script to sit after the 2nd H2. */}
					<InlineNewsletter
						class="js-mid-news mid-news"
						source="article-mid"
						line="Stories like this, gathered once a week — Sundays, in your inbox."
					/>

					<div class="sectionbreak"><span class="star">✦</span></div>

					<div class="author">
						<a href={authorHref} class="ab-avatar-link author__portrait" aria-label={`More by ${author.name}`}>
							{
								author.avatar ? (
									<Image src={author.avatar} alt={author.name} width={160} height={160} />
								) : (
									<div class="ph" data-label="Author" />
								)
							}
						</a>
						<div>
							<p class="ab-name"><a href={authorHref}>{author.name}</a></p>
							<p class="ab-role">{author.role}</p>
							<p>{author.bio}</p>
							<a class="tlink" href={authorHref}>Read more by {author.name} →</a>
						</div>
					</div>
				</div>

				<aside class="art-rail">
					<div class="art-rail__sticky">
						<div class="media ar-4-5 art-rail__thumb">
							<Image src={heroImage} alt={title} widths={[300, 500]} sizes="25vw" />
						</div>
						<div class="share" aria-label="Share">
							<button data-share-copy type="button" aria-label="Copy link">LINK</button>
							<a
								href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical.toString())}&text=${encodeURIComponent(title)}`}
								target="_blank"
								rel="noopener"
								aria-label="Share on X">X</a
							>
							<a
								href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical.toString())}`}
								target="_blank"
								rel="noopener"
								aria-label="Share on Facebook">FB</a
							>
						</div>
						{
							related.length > 0 && (
								<>
									<p class="rail-list__h">Continue reading</p>
									<nav class="rail-list" aria-label="Related">
										{related.slice(0, 3).map((r, i) => (
											<a class="hl-link" href={r.href} style={i === Math.min(related.length, 3) - 1 ? 'border-bottom:0' : undefined}>
												<span class="h5 hl" style="font-size:17px">{r.title}</span>
											</a>
										))}
									</nav>
								</>
							)
						}
					</div>
				</aside>
			</div>
		</div>
	</article>

	<!-- CONTINUE WITH (oversized next-article card) -->
	{
		readNext && (
			<section class="section article-read-next" style="border-top:1px solid var(--hairline)">
				<div class="wrap">
					<p class="eyebrow eyebrow--emerald" style="margin-bottom:32px">Read next →</p>
					<a class="hl-link readnext" href={readNext.href}>
						<div class="media ar-5-7" style="max-height:520px">
							{readNext.image ? (
								<Image src={readNext.image} alt={readNext.title} widths={[480, 800]} sizes="(max-width:900px) 100vw, 40vw" />
							) : (
								<div class="ph" data-label={`${readNext.categoryLabel} · 5:7`} />
							)}
						</div>
						<div>
							<p class="kicker11" style="margin-bottom:16px">{readNext.categoryLabel}</p>
							<h2 class="h3"><span class="hl">{readNext.title}</span></h2>
							<p class="dek" style="font-size:var(--body);font-style:normal;color:var(--ink-2);margin-top:16px;max-width:46ch">{readNext.byline}</p>
						</div>
					</a>
				</div>
			</section>
		)
	}

	<!-- ALSO FROM CATEGORY -->
	{
		related.length > 0 && (
			<section class="section--tight article-more">
				<div class="wrap">
					<p class="eyebrow" style="margin-bottom:24px">Also from {categoryLabel}</p>
					<hr class="rule" style="margin-bottom:40px" />
					<div class="more-grid">
						{related.slice(0, 3).map((r) => (
							<StoryCard
								href={r.href}
								title={r.title}
								image={r.image}
								ratio="3x2"
								heading="h5"
								category={category}
								label={`${categoryLabel} · 3:2`}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- NEWSLETTER BAND (identical to homepage) -->
	<section class="tint article-end-newsletter">
		<div class="wrap"><div class="grid">
			<div style="grid-column:4 / 10; text-align:center">
				<h2 class="h2" style="margin-bottom:16px">Sundays, considered.</h2>
				<p class="dek" style="margin-bottom:40px">Our weekly edit — one essay, three things to read, one place to go.</p>
				<NewsletterSignup source="article-end">
					<p slot="note" class="field-note" style="text-align:center;margin-top:20px">No noise. Unsubscribe anytime.</p>
				</NewsletterSignup>
			</div>
		</div></div>
	</section>

	<script>
		// Relocate the mid-article newsletter to sit after the 2nd H2 in the body
		// (a natural pause for an engaged reader). If the piece is short (<2 H2s),
		// drop it — the end-of-article unit already covers the high-intent moment.
		function placeMidNews() {
			const mid = document.querySelector<HTMLElement>('.js-mid-news');
			if (!mid || mid.dataset.placed) return;
			const body = document.querySelector('.article-body');
			const h2s = body ? Array.from(body.querySelectorAll(':scope > h2')) : [];
			if (h2s.length >= 2) {
				h2s[1].insertAdjacentElement('beforebegin', mid);
				mid.dataset.placed = '1';
			} else {
				mid.remove();
			}
		}
		document.addEventListener('astro:page-load', placeMidNews);
	</script>
</BaseLayout>
