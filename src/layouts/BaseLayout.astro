---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Seo from '../components/Seo.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { organizationSchema, websiteSchema } from '../lib/seo';
import defaultOgAsset from '../assets/og-default.png';
import { getSearchIndex } from '../lib/articles';
import '../styles/global.css';
import '../styles/pages.css';

// Self-hosted variable fonts (Fontsource) for the v2 system:
// Bodoni Moda (Didone display + italics), Source Serif 4 (editorial body +
// italics), Inter (UI/meta). opsz axes power optical sizing.
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/inter/wght.css';
// Preload the two critical latin faces (body serif + Didone display) so the
// first paint doesn't wait on stylesheet discovery — an LCP win on 4G.
import serifWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import displayWoff2 from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';

interface Props {
	title: string;
	description?: string;
	activeCategory?: string;
	overHero?: boolean;
	noFooter?: boolean;
	/** Absolute URL to an OG/Twitter image. Falls back to a branded default. */
	image?: string;
	imageWidth?: number;
	imageHeight?: number;
	ogType?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	authorName?: string;
	section?: string;
	tags?: string[];
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description = "Asia's modern-luxury edit — modestly told.",
	activeCategory,
	noFooter = false,
	image,
	ogType = 'website',
	noindex = false,
	publishedTime,
	modifiedTime,
	authorName,
	section,
	tags,
	imageWidth = 1200,
	imageHeight = 630,
	jsonLd = [organizationSchema(), websiteSchema()],
} = Astro.props;

// Default social card when a page supplies none (homepage, index pages).
const defaultOg = await getImage({
	src: defaultOgAsset,
	width: 1200,
	height: 630,
	format: 'jpg',
});
const ogImage = image ?? new URL(defaultOg.src, Astro.site).toString();

// All eight categories stay reachable (v2-styled nav), plus a curated
// "The Long Read" entry pointing at the latest features feed.
const categories = [
	'Style',
	'Beauty',
	'Dining',
	'Travel',
	'Culture',
	'Living',
	'People',
	'Guides',
];
const navItems = categories.map((c) => ({
	label: c,
	href: `/${c.toLowerCase()}`,
	active: c === activeCategory,
}));
// Keep the visible masthead deliberately concise. The full taxonomy remains
// available in the editorial menu and footer without making every page feel
// like a directory.
const primaryNav = [
	...navItems.filter((n) => ['Style', 'Beauty', 'Dining', 'Travel', 'Culture', 'Living'].includes(n.label)),
	{ label: 'The Majlis', href: '/franchises/the-majlis/', active: false },
];

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';

// Slim JSON index for the client search overlay.
const searchIndex = await getSearchIndex();

// Google Tag Manager — renders nothing until PUBLIC_GTM_ID is set in the
// environment (Vercel → Settings → Environment Variables). Never loads on
// the Keystatic admin. See docs/domain-analytics-setup.md.
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const gtmEnabled = /^GTM-[A-Z0-9]+$/.test(gtmId ?? '') && !Astro.url.pathname.startsWith('/keystatic');
const gtmSnippet = gtmEnabled
	? `window.dataLayer=window.dataLayer||[];(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
	: '';
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		{gtmEnabled && <script is:inline set:html={gtmSnippet} />}
		<link rel="preload" as="font" type="font/woff2" href={serifWoff2} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={displayWoff2} crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#FFFFFF" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-adsense-account" content="ca-pub-7886081043408699" />
		<script
			is:inline
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7886081043408699"
			crossorigin="anonymous"
		></script>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Arahkaii"
			href={new URL('rss.xml', Astro.site)}
		/>

		<Seo
			title={title}
			description={description}
			canonical={canonical}
			image={ogImage}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
			ogType={ogType}
			noindex={noindex}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			authorName={authorName}
			section={section}
			tags={tags}
			jsonLd={jsonLd}
		/>

		<ClientRouter />
	</head>

	<body>
		{
			gtmEnabled && (
				<noscript>
					<iframe
						src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
						height="0"
						width="0"
						style="display:none;visibility:hidden"
						title="Google Tag Manager"
					/>
				</noscript>
			)
		}
		<a class="skip-link" href="#main">Skip to content</a>

		<!-- article scroll-progress (set by the script; invisible elsewhere) -->
		<div class="progress"><span data-progress></span></div>

		<!-- sticky condensed bar (Vogue hide-on-down / show-on-up) -->
		<div class="stickybar" role="banner">
			<a class="stickybar__mark" href="/">ARAHKAII</a>
			<nav class="stickybar__nav" aria-label="Sections">
				{primaryNav.map((n) => <a class="navlink" href={n.href}>{n.label.toUpperCase()}</a>)}
			</nav>
			<div class="stickybar__right">
				<button class="masthead__util" data-search-toggle type="button">SEARCH</button>
				<button class="masthead__util" data-menu-open type="button">MENU</button>
			</div>
		</div>

		<!-- masthead -->
		<header class="masthead">
			<div class="wrap">
				<div class="masthead__top">
					<button class="masthead__util" data-menu-open type="button">MENU</button>
					<button class="masthead__util" data-search-toggle type="button">SEARCH</button>
				</div>
				<a href="/" aria-label="Arahkaii — home">
					{
						isHome ? (
							<h1 class="wordmark">ARAHKAII</h1>
						) : (
							<p class="wordmark">ARAHKAII</p>
						)
					}
				</a>
				<hr class="rule" />
				<nav class="masthead__nav" aria-label="Primary">
					{
						primaryNav.map((n) => (
							<a class="navlink" href={n.href} aria-current={n.active ? 'page' : undefined}>
								{n.label.toUpperCase()}
							</a>
						))
					}
				</nav>
				<hr class="rule d-only" />
			</div>
			<!-- inline search -->
			<div class="searchbar">
				<div class="wrap">
					<div class="searchbar__inner">
						<span class="eyebrow">Search</span>
						<input
							class="search-input"
							type="search"
							placeholder="Search essays, places, people…"
							aria-label="Search"
							autocomplete="off"
						/>
						<button class="masthead__util" data-search-toggle type="button">CLOSE</button>
					</div>
					<div class="search-results" role="region" aria-live="polite" hidden></div>
				</div>
			</div>
		</header>

		<!-- full-screen overlay menu -->
		<div class="overlay" role="dialog" aria-modal="true" aria-label="Menu">
			<div class="overlay__top">
				<a class="overlay__mark" href="/">ARAHKAII</a>
				<button class="overlay__close" data-menu-close type="button">CLOSE ✕</button>
			</div>
			<div class="overlay__body">
				<nav class="overlay__list" aria-label="Editorial sections">
					<p class="overlay__label">Explore</p>
					{navItems.map((n) => <a href={n.href}>{n.label}</a>)}
					<a href="/franchises/the-majlis/">The Majlis</a>
				</nav>
				<div class="overlay__aside">
					<p class="overlay__label">Arahkaii</p>
					<a href="/latest">Latest stories</a>
					<a href="/contributors">Editors &amp; contributors</a>
					<a href="/about">Our story</a>
					<a href="/reading-list">Reading list</a>
					<a href="/contact">Contact</a>
					<div class="overlay__note">
						<p>Sundays, considered.</p>
						<a href="/subscribe">Join the weekly edit →</a>
					</div>
				</div>
			</div>
		</div>

		<main id="main">
			<slot />
		</main>

		{
			!noFooter && (
				<footer class="footer" id="site-footer">
					<div class="footer__cols">
						<div class="footer__intro">
							<p class="footer__mark">ARAHKAII</p>
							<p class="footer__mission">Asia’s modern-luxury edit — modestly told.</p>
							<div class="footer__news">
								<p class="footer__h">The Sunday edit</p>
								<NewsletterSignup class="fn-form" source="footer">
									<p slot="note" class="field-note" style="color:var(--footer-head)">
										One considered email. No noise.
									</p>
								</NewsletterSignup>
							</div>
						</div>
						<div>
							<p class="footer__h">Explore</p>
							<div class="footer__links">
								<a href="/latest">Latest</a>
								<a href="/style">Style</a>
								<a href="/beauty">Beauty</a>
								<a href="/dining">Dining</a>
								<a href="/travel">Travel</a>
								<a href="/guides">Arahkaii Guides</a>
							</div>
						</div>
						<div>
							<p class="footer__h">About</p>
							<div class="footer__links">
								<a href="/about">Our story</a>
								<a href="/contributors">Contributors</a>
								<a href="/contact">Contact</a>
								<a href="/advertise">Work with us</a>
								<a href="/faqs">FAQs</a>
								<a href="/editorial-standards">Editorial standards</a>
								<a href="/rss.xml">RSS</a>
							</div>
						</div>
					</div>
					<div class="footer__bottom">
						<div class="footer__social" aria-label="Follow Arahkaii">
							<a href="https://www.instagram.com/arahkaii/" rel="me">Instagram</a>
							<a href="https://www.tiktok.com/@arahkaii" rel="me">TikTok</a>
							<a href="https://www.facebook.com/arahkaii" rel="me">Facebook</a>
							<a href="https://www.x.com/arahkaii" rel="me">X</a>
						</div>
						<p class="footer__fine">© {new Date().getFullYear()} Arahkaii · ONN GROUP LLP · Singapore · <a href="/privacy-policy">Privacy</a> · <a href="/terms-conditions">Terms</a></p>
					</div>
				</footer>
			)
		}

		<!-- Build-time article index, read by the client search overlay -->
		<script
			is:inline
			type="application/json"
			id="arahkaii-index"
			set:html={JSON.stringify(searchIndex)}
		/>

		<script>
			// ARAHKAII v2 chrome + interactions. DOM-creating behaviours run on every
			// astro:page-load; document-level listeners bind once (document persists
			// across View Transitions).
			const SUBKEY = 'arahkaii:subscribed';
			const SUBSCRIBED_HTML =
				'<span class="news-done"><span class="nd-tick">✓</span> You’re subscribed. See you Sunday.</span>';

			const isSubscribed = () => {
				try {
					return !!localStorage.getItem(SUBKEY);
				} catch {
					return false;
				}
			};
			function renderSubscribedForms() {
				document.querySelectorAll<HTMLElement>('.js-news').forEach((form) => {
					const field = form.querySelector<HTMLElement>('.field');
					if (field && !field.dataset.locked) {
						field.dataset.locked = '1';
						field.classList.add('done');
						field.innerHTML = SUBSCRIBED_HTML;
					}
					const note = form.querySelector<HTMLElement>('.field-note');
					if (note) note.textContent = 'Manage your preferences anytime.';
				});
			}

			function getIndex(): any[] {
				const el = document.getElementById('arahkaii-index');
				if (!el) return [];
				try {
					return JSON.parse(el.textContent || '[]');
				} catch {
					return [];
				}
			}
			// ---- inline search ----
			function wireSearch() {
				const bar = document.querySelector<HTMLElement>('.searchbar');
				if (!bar) return;
				const input = bar.querySelector<HTMLInputElement>('.search-input');
				const results = bar.querySelector<HTMLElement>('.search-results');
				const idx = getIndex();
				function run(q: string) {
					if (!results) return;
					q = (q || '').trim().toLowerCase();
					if (!q) {
						results.hidden = true;
						results.innerHTML = '';
						return;
					}
					results.hidden = false;
					const hits = idx
						.filter((x) => (x.t + ' ' + x.c + ' ' + x.a).toLowerCase().includes(q))
						.slice(0, 7);
					results.innerHTML = hits.length
						? hits
								.map(
									(x) =>
										`<a href="${x.h}"><span class="sr-cat">${x.c}</span><span class="sr-title">${x.t}</span></a>`,
								)
								.join('')
						: `<p class="sr-empty">No stories yet for “${q}”. Try a category, an author, or a place.</p>`;
				}
				input?.addEventListener('input', () => run(input.value));
			}

			// ---- reveals (once, staggered, reduced-motion aware) ----
			let io: IntersectionObserver | null = null;
			function observe() {
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (reduce || !('IntersectionObserver' in window)) {
					document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
					return;
				}
				if (!io)
					io = new IntersectionObserver(
						(entries) => {
							entries.forEach((en) => {
								if (en.isIntersecting) {
									const el = en.target as HTMLElement;
									const delay = parseInt(el.getAttribute('data-stagger') || '0', 10);
									setTimeout(() => el.classList.add('in'), delay);
									io!.unobserve(el);
								}
							});
						},
						{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
					);
				document.querySelectorAll('.reveal:not(.in)').forEach((el) => io!.observe(el));
				// Insurance: reveal anything still hidden after 1.4s (some webviews).
				setTimeout(() => {
					document.querySelectorAll('.reveal:not(.in)').forEach((el) => el.classList.add('in'));
				}, 1400);
			}

			// ---- rail carousels ----
			function wireRails() {
				document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
					if (rail.dataset.wired) return;
					rail.dataset.wired = '1';
					const track = rail.querySelector<HTMLElement>('[data-rail-track]');
					const prev = rail.querySelector<HTMLElement>('[data-rail-prev]');
					const next = rail.querySelector<HTMLElement>('[data-rail-next]');
					const barEl = rail.querySelector<HTMLElement>('[data-rail-bar]');
					if (!track) return;
					const step = () => {
						const card = track.querySelector<HTMLElement>('.snap');
						return card ? card.getBoundingClientRect().width + 24 : 320;
					};
					const update = () => {
						if (!barEl) return;
						const max = track.scrollWidth - track.clientWidth;
						const p = max > 0 ? track.scrollLeft / max : 0;
						barEl.style.transform = 'scaleX(' + Math.max(0.08, Math.min(1, p)).toFixed(3) + ')';
					};
					prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
					next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
					track.addEventListener('scroll', update, { passive: true });
					track.setAttribute('tabindex', '0');
					track.addEventListener('keydown', (e) => {
						if (e.key === 'ArrowRight') {
							e.preventDefault();
							track.scrollBy({ left: step(), behavior: 'smooth' });
						}
						if (e.key === 'ArrowLeft') {
							e.preventDefault();
							track.scrollBy({ left: -step(), behavior: 'smooth' });
						}
					});
					update();
				});
			}

			// ---- copy-link share buttons ----
			function wireShare() {
				document.querySelectorAll<HTMLElement>('[data-share-copy]').forEach((b) => {
					if (b.dataset.wired) return;
					b.dataset.wired = '1';
					b.addEventListener('click', (e) => {
						e.preventDefault();
						navigator.clipboard?.writeText(location.href).catch(() => {});
					});
				});
			}

			function initChrome() {
				wireSearch();
				wireRails();
				wireShare();
				observe();
				if (isSubscribed()) renderSubscribedForms();
			}

			if (!(window as any).__arahkaiiBound) {
				(window as any).__arahkaiiBound = true;

				// sticky condensed bar — show after 200px, hide on scroll-down past
				// 600px, reappear on scroll-up.
				let lastY = window.scrollY;
				const onScroll = () => {
					const bar = document.querySelector<HTMLElement>('.stickybar');
					if (bar) {
						const y = window.scrollY;
						if (y < 200) bar.classList.remove('show');
						else if (y > 600 && y > lastY) bar.classList.remove('show');
						else bar.classList.add('show');
						lastY = y;
					}
					// article scroll progress
					const prog = document.querySelector<HTMLElement>('[data-progress]');
					const article = document.querySelector<HTMLElement>('[data-article-body]');
					if (prog && article) {
						const rect = article.getBoundingClientRect();
						const total = rect.height - window.innerHeight;
						const done = Math.min(1, Math.max(0, -rect.top / (total > 0 ? total : 1)));
						prog.style.transform = 'scaleX(' + done.toFixed(3) + ')';
					}
				};
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll);

				// overlay menu
				document.addEventListener('click', (e) => {
					const t = e.target as HTMLElement;
					const overlay = document.querySelector<HTMLElement>('.overlay');
					if (t.closest('[data-menu-open]')) {
						overlay?.classList.add('open');
						document.body.style.overflow = 'hidden';
						overlay?.querySelector<HTMLElement>('[data-menu-close]')?.focus();
					}
					if (t.closest('[data-menu-close]') || (t.closest('.overlay a') && overlay)) {
						overlay?.classList.remove('open');
						document.body.style.overflow = '';
					}
					if (t.closest('[data-search-toggle]')) {
						const sb = document.querySelector<HTMLElement>('.searchbar');
						const open = sb?.classList.toggle('open');
						if (open) (sb?.querySelector('input') as HTMLInputElement | null)?.focus();
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						const overlay = document.querySelector<HTMLElement>('.overlay');
						const sb = document.querySelector<HTMLElement>('.searchbar');
						if (overlay?.classList.contains('open')) {
							overlay.classList.remove('open');
							document.body.style.overflow = '';
						}
						sb?.classList.remove('open');
					}
				});

				// Newsletter submit — validate, persist through our server endpoint,
				// then remember the successful subscription on this device.
				document.addEventListener('submit', async (e) => {
					const form = (e.target as HTMLElement).closest<HTMLFormElement>('.js-news');
					if (!form) return;
					e.preventDefault();
					const field = form.querySelector<HTMLElement>('.field');
					const input = form.querySelector<HTMLInputElement>('input[type="email"]');
					const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
					const website = form.querySelector<HTMLInputElement>('input[name="website"]');
					const v = (input?.value || '').trim();
					const ok = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);
					const note = form.querySelector<HTMLElement>('.field-note');
					if (!ok) {
						if (note) {
							note.textContent = 'Please enter a valid email address.';
							note.style.color = 'var(--emerald)';
						}
						input?.focus();
						return;
					}
					button?.setAttribute('disabled', '');
					form.setAttribute('aria-busy', 'true');
					if (note) {
						note.textContent = 'Subscribing…';
						note.style.color = 'var(--ink-2)';
					}
					try {
						const response = await fetch('/api/subscribe', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: v,
								source: form.dataset.source || 'inline',
								website: website?.value || '',
							}),
						});
						if (!response.ok) throw new Error('Subscription request failed');
					} catch {
						button?.removeAttribute('disabled');
						form.removeAttribute('aria-busy');
						if (note) {
							note.textContent = 'We could not subscribe you just now. Please try again.';
							note.style.color = 'var(--emerald)';
						}
						return;
					}
					try {
						localStorage.setItem(SUBKEY, v);
					} catch {}
					// Analytics: GTM listens for this custom event (see
					// docs/gtm-arahkaii-ga4.json). No-op when GTM is absent.
					(window as any).dataLayer?.push({ event: 'newsletter_signup', source: form.dataset.source || 'inline' });
					if (field) {
						field.classList.add('done');
						field.dataset.locked = '1';
						field.innerHTML = SUBSCRIBED_HTML;
					}
					if (note) {
						note.textContent = 'A confirmation is on its way to ' + v + '.';
						note.style.color = 'var(--ink-2)';
					}
					form.removeAttribute('aria-busy');
				});

				onScroll();
			}

			document.addEventListener('astro:page-load', initChrome);

			// Virtual page views for GA4: the ClientRouter swaps pages without a
			// full load, so surface each navigation to GTM. Fires on the initial
			// load too — the GA4 config tag in the container listens for this
			// event instead of All Pages to avoid double-counting.
			document.addEventListener('astro:page-load', () => {
				(window as any).dataLayer?.push({
					event: 'virtual_page_view',
					page_path: location.pathname + location.search,
					page_title: document.title,
				});
			});
		</script>
	</body>
</html>
