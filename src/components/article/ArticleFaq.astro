---
interface Item { q: string; a: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

{items.length > 0 && (
	<section class="article-faq" aria-labelledby="article-faq-title">
		<p class="eyebrow eyebrow--emerald">Reader questions</p>
		<h2 id="article-faq-title">Frequently asked questions</h2>
		<div>{items.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
	</section>
)}
