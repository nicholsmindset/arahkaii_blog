---
export interface HalalStatusData {
	status: 'muis-certified' | 'muslim-owned' | 'pork-free-no-alcohol' | 'mixed-status-guide' | 'not-applicable';
	verifiedDate?: Date;
	certificateRef?: string;
	sourceUrl?: string;
	note?: string;
}
interface Props { data: HalalStatusData; }
// The `halalStatus` frontmatter is retained as an internal editorial QA record
// (verified per venue, kept in lockstep by scripts/validate-content.mjs) but is
// no longer rendered publicly — Arahkaii is a modern-luxury edit for everyone,
// so religious labelling is not foregrounded on the page. Curation (pork-free,
// no alcohol) is invisible by design. This component intentionally renders
// nothing; the type export is kept so callers/props stay valid.
const _props = Astro.props as Props;
void _props;
---

