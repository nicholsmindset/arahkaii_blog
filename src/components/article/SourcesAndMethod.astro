---
import { fmtDate } from '../../lib/format';
export interface EditorialSource {
	name: string;
	url: string;
	accessed?: Date;
}

interface Props {
	sources?: EditorialSource[];
	method?: string;
}

const { sources = [], method } = Astro.props;
const date = (value: Date) =>
	fmtDate(value, { day: 'numeric', month: 'short', year: 'numeric' });
---

{(method || sources.length > 0) && (
	<aside class="article-sources" aria-labelledby="sources-and-method-title">
		<p class="article-sources__eyebrow">Transparency</p>
		<h2 id="sources-and-method-title">Sources &amp; method</h2>
		{method && <p>{method}</p>}
		{sources.length > 0 && (
			<ul>
				{sources.map((source) => (
					<li>
						<a href={source.url} rel="noopener noreferrer" target="_blank">{source.name}</a>
						{source.accessed && <span> — accessed {date(source.accessed)}</span>}
					</li>
				))}
			</ul>
		)}
	</aside>
)}
