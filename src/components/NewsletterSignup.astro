---
// Shared newsletter form. The `.js-news` class + `.field` markup is what the
// global submit handler (BaseLayout) looks for — it validates the email, sends
// it to `/api/subscribe`, remembers a successful subscription in localStorage,
// and swaps the field for a confirmation. `data-source` records where the form
// appeared for future analytics.
interface Props {
	class?: string;
	/** Where this form lives — tagged on the form for analytics later. */
	source?: string;
}
const { class: cls, source = 'inline' } = Astro.props;
---

<form class:list={['js-news', cls]} data-source={source} novalidate>
	<label class="sr-only" aria-hidden="true">
		Website
		<input name="website" type="text" tabindex="-1" autocomplete="off" />
	</label>
	<div class="field">
		<input name="email" type="email" placeholder="your@email.com" aria-label="Email address" autocomplete="email" maxlength="254" required />
		<button type="submit">Subscribe <span aria-hidden="true">→</span></button>
	</div>
	{Astro.slots.has('note') ? <slot name="note" /> : <p class="field-note" aria-live="polite"></p>}
</form>
