---
// Shared newsletter form. The `.js-news` class + `.field` markup is what the
// global submit handler (BaseLayout) looks for — it validates the email,
// POSTs the submission to Netlify Forms, remembers it in localStorage, and
// swaps the field for a confirmation. `data-source` records WHERE a signup
// happened (footer, article, sticky bar, …).
//
// The form is registered with Netlify at deploy time via `data-netlify` —
// submissions land in the Netlify Forms inbox (forward to MailerLite later).
// `netlify-honeypot` + the hidden `bot-field` give baseline spam protection.
// The `note` slot has a default `.field-note` so every placement — including
// mid-article, which passes no slot — can show validation/error messages.
interface Props {
	class?: string;
	/** Where this form lives — tagged on the form for analytics later. */
	source?: string;
}
const { class: cls, source = 'inline' } = Astro.props;
---

<form
	class:list={['js-news', cls]}
	name="newsletter"
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	data-source={source}
	novalidate
>
	<input type="hidden" name="form-name" value="newsletter" />
	<input type="hidden" name="source" value={source} />
	<p hidden aria-hidden="true">
		<label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
	</p>
	<div class="field">
		<input type="email" name="email" placeholder="your@email.com" aria-label="Email address" />
		<button type="submit">Subscribe <span aria-hidden="true">→</span></button>
	</div>
	<slot name="note">
		<p class="field-note" aria-live="polite"></p>
	</slot>
</form>
