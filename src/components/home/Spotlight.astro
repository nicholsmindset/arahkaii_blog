---
import { Image } from 'astro:assets';
import type { PostCard } from '../../lib/articles';

// Long-form spotlight — a wide feature block beneath the lanes.
interface Props {
	card: PostCard;
	eyebrow?: string;
}
const { card, eyebrow = `${card.categoryLabel} · The Long Read` } = Astro.props;
---

<a class="story spotlight" href={card.url}>
	<div class="img real r-3x2 blurup">
		<Image src={card.image} alt={card.heroCaption || card.title} />
	</div>
	<div class="rise">
		<span class="eyebrow accent">{eyebrow}</span>
		<h2 class="headline">{card.title}</h2>
		<p class="dek">{card.standfirst}</p>
		<p class="byline">{card.byline}</p>
	</div>
</a>
