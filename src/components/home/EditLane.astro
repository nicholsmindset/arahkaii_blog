---
import StoryCard from '../StoryCard.astro';
import type { PostCard } from '../../lib/articles';

// Horizontal-scroll category lane (homepage).
interface Props {
	title: string;
	href: string;
	items: PostCard[];
}
const { title, href, items } = Astro.props;
---

<div class="lane">
	<div class="lane-head rise">
		<h2 class="lane-title">{title}</h2>
		<a class="link-more" href={href}>All {title}</a>
	</div>
	<div class="lane-scroll">
		{
			items.map((x) => (
				<StoryCard
					class="lane-card"
					href={x.url}
					title={x.title}
					byline={x.byline}
					image={x.image}
					tone={x.tone}
					ratio="3x2"
				/>
			))
		}
	</div>
</div>
