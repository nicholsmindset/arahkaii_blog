---
import { Image } from 'astro:assets';
import type { PostCard } from '../../lib/articles';

// Asymmetric feature block: one large lead story (left) beside a stacked pair
// of smaller stories (right). Breaks the uniform card-row rhythm.
interface Props {
	lead: PostCard;
	rest: PostCard[]; // up to 2
}
const { lead, rest } = Astro.props;
const side = rest.slice(0, 2);
---

<section class="sec feature-pair">
	<a class="story fp-lead" href={lead.url}>
		<div class="img real r-3x2 blurup">
			<Image src={lead.image} alt={lead.heroCaption || lead.title} />
		</div>
		<span class="eyebrow accent fp-eyebrow">{lead.categoryLabel} · Feature</span>
		<h2 class="headline fp-headline">{lead.title}</h2>
		<p class="fp-stand">{lead.standfirst}</p>
		<p class="byline">{lead.byline}</p>
	</a>

	<div class="fp-side">
		{
			side.map((c) => (
				<a class="story fp-item" href={c.url}>
					<div class="img real r-3x2 blurup">
						<Image src={c.image} alt={c.heroCaption || c.title} />
					</div>
					<div class="fp-item-body">
						<span class="eyebrow fp-item-eyebrow">{c.categoryLabel}</span>
						<h3 class="headline">{c.title}</h3>
						<p class="byline">{c.byline}</p>
					</div>
				</a>
			))
		}
	</div>
</section>
