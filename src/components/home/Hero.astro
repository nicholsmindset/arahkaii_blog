---
import { Image } from 'astro:assets';
import type { PostCard } from '../../lib/articles';

// Homepage cover story — whole block clickable, full-bleed 16:9 hero with a
// soft top scrim for nav legibility (nav sits transparent over it).
interface Props {
	card: PostCard;
	eyebrow?: string;
}
const { card, eyebrow = `${card.categoryLabel} · The Cover Story` } = Astro.props;
---

<a class="hero story" href={card.url}>
	<div class="hero-full img real blurup in">
		<Image src={card.image} alt={card.heroCaption || card.title} loading="eager" />
	</div>
	<div class="hero-cap">
		<span class="eyebrow">{eyebrow}</span>
		<h1 class="hero-headline display">{card.title}</h1>
		<p class="epigraph">{card.standfirst}</p>
		<p class="byline">{card.byline}</p>
	</div>
</a>
