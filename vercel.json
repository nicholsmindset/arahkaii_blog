{
	"framework": "astro",
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "www.arahkaii.com" }],
			"destination": "https://arahkaii.com/:path*",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/keystatic/:path*",
			"headers": [
				{ "key": "X-Robots-Tag", "value": "noindex, nofollow" },
				{ "key": "Cache-Control", "value": "no-store" }
			]
		},
		{
			"source": "/api/keystatic/:path*",
			"headers": [
				{ "key": "X-Robots-Tag", "value": "noindex, nofollow" },
				{ "key": "Cache-Control", "value": "no-store" }
			]
		}
	]
}
