# Arahkaii — local secrets for the /publish pipeline.
# Copy to .env (gitignored). None are needed for `npm run build` — images are
# pre-committed; these only power the local publish scripts.

# AI image generation. Set EITHER key — scripts/image-gen.mjs auto-selects:
#   OPENAI_API_KEY     → OpenAI Images API (gpt-image-1), the direct path
#   OPENROUTER_API_KEY → OpenRouter (one key flips GPT-Image/Flux/Gemini)
# If both are set, OpenAI wins (override with AR_IMAGE_PROVIDER=openrouter).
# Optional today — Firecrawl sourcing works without either.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults in scripts/image-gen.mjs):
# AR_MODEL_HERO=openai/gpt-image-1
# AR_MODEL_INLINE=google/gemini-2.5-flash-image
# AR_MODEL_BULK=black-forest-labs/flux-2-klein

# Image sourcing (Firecrawl). The Firecrawl MCP is already connected for
# interactive sourcing; this key is only for a scripted path later.
FIRECRAWL_API_KEY=

# Newsletter provider is selected in Keystatic → Newsletter settings.
# Store credentials in Vercel Production and Preview, never in the CMS.
MAILERLITE_API_KEY=
# Optional: add every signup to a specific MailerLite group.
MAILERLITE_GROUP_ID=
BEEHIIV_API_KEY=
# Required when Beehiiv is selected; begins with `pub_`.
BEEHIIV_PUBLICATION_ID=

# Contact delivery on Vercel via Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@arahkaii.com
CONTACT_FROM_EMAIL=Arahkaii Website <website@arahkaii.com>

# Keystatic CMS — required in Vercel for /keystatic GitHub authentication.
# Create these by completing the GitHub App setup from the local CMS.
# Set this to `github` locally only while creating or testing the GitHub App.
KEYSTATIC_STORAGE_KIND=local
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Image hosting — local-first today (images live in src/assets/images/).
# Fill these only when migrating to Cloudflare R2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE=https://cdn.arahkaii.com
