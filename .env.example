# Arahkaii — local secrets for the /publish pipeline.
# Copy to .env (gitignored). None are needed for `npm run build` — images are
# pre-committed; these only power the local publish scripts.

# AI image generation. Set EITHER key — scripts/image-gen.mjs auto-selects:
#   OPENAI_API_KEY     → OpenAI Images API, the direct path
#   OPENROUTER_API_KEY → OpenRouter (one key flips GPT-Image/Flux/Gemini)
# If both are set, OpenAI wins (override with AR_IMAGE_PROVIDER=openrouter).
# OpenRouter is the primary path for /illustrate. Optional today — Firecrawl
# sourcing works without either; `npm run build` needs no key (images committed).
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model routing (current OpenRouter IDs, June 2026). /illustrate routes by
# fidelity: heroes + people/hands templates → AR_MODEL_TEXT; mood/still-life → AR_MODEL_MOOD.
# AR_MODEL_TEXT=google/gemini-3-pro-image-preview     # top fidelity (heroes, faces/hands)
# AR_MODEL_MOOD=black-forest-labs/flux.2-pro          # mood / still-life
# AR_MODEL_HERO=google/gemini-3-pro-image-preview     # hero (defaults to AR_MODEL_TEXT)
# AR_MODEL_INLINE=google/gemini-3.1-flash-image       # fast/cheap inline default (CLI)
# AR_MODEL_BULK=black-forest-labs/flux.2-pro          # bulk default (CLI)
# AR_GEN_CREDIT=Arahkaii                              # credit stamped on generated images

# Image sourcing (Firecrawl). The Firecrawl MCP is already connected for
# interactive sourcing; this key is only for a scripted path later.
FIRECRAWL_API_KEY=

# Newsletter (MailerLite) — for the capture API + RSS digest, added later.
MAILERLITE_API_KEY=

# Image hosting — local-first today (images live in src/assets/images/).
# Fill these only when migrating to Cloudflare R2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE=https://cdn.arahkaii.com
